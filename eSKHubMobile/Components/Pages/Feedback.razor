@page "/feedback"
@using eSKHubMobile.Services
@using eSKHubMobile.Models
@inject AuthService AuthService
@inject OfflineDbService OfflineDb
@inject NavigationManager Navigation
@inject OfflineSyncService SyncService

<div class="page-container">
    <header class="page-header">
        <button class="back-btn" @onclick='() => Navigation.NavigateTo("/home")'>
            <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <h1>Submit Feedback</h1>
        <button class="history-btn" @onclick="ShowHistoryModal">
            <svg viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
    </header>

    <div class="content-area">
        <div class="feedback-card">
            <div class="card-accent"></div>
            <div class="card-body">
                <p class="intro-text">We value your feedback! Share your thoughts, suggestions, or concerns with us.</p>

                <div class="user-info-banner">
                    <div class="info-item">
                        <span class="label">Submitted by</span>
                        <span class="value">@AuthService.Fullname</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Position</span>
                        <span class="value">@AuthService.Position (@AuthService.Area)</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Category</label>
                    <select @bind="_feedback.Category" class="form-control">
                        <option value="General">General Feedback</option>
                        <option value="Suggestion">Suggestion</option>
                        <option value="Complaint">Complaint</option>
                        <option value="Inquiry">Inquiry</option>
                        <option value="Appreciation">Appreciation</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Subject</label>
                    <input @bind="_feedback.Subject" type="text" placeholder="Brief summary of your feedback" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Message</label>
                    <textarea @bind="_feedback.Message" rows="6" placeholder="Tell us more..." class="form-control"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="error-msg">@_errorMessage</div>
                }

                @if (_isSuccess)
                {
                    <div class="success-msg">
                        <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" fill="none" stroke="currentColor" stroke-width="2" /><path d="M22 4L12 14.01l-3-3" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                        Thank you! Your feedback has been submitted.
                    </div>
                }

                <button class="submit-btn" @onclick="HandleSubmit" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner"></span>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <span>Submit Feedback</span>
                    }
                </button>
            </div>
        </div>
    </div>
    @if (_showHistoryModal)
    {
        <div class="modal-overlay">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>My Feedback History</h3>
                    <button class="close-btn" @onclick="CloseHistoryModal">&times;</button>
                </div>
                <div class="modal-body">
                    @if (_userFeedbacks == null || !_userFeedbacks.Any())
                    {
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <p>No feedback history found.</p>
                        </div>
                    }
                    else
                    {
                        <div class="feedback-list">
                            @foreach (var item in _userFeedbacks)
                            {
                                <div class="feedback-item">
                                    <div class="item-header">
                                        <span class="category-badge">@item.Category</span>
                                        <span class="date">@item.DateSubmitted.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    <div class="item-subject">@item.Subject</div>
                                    <div class="item-message">@item.Message</div>
                                    <div class="item-footer">
                                        @if (item.IsSynced)
                                        {
                                            <span class="status-badge success">
                                                <svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                                                Submitted
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge warning">
                                                <svg viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                                                Pending (Connectivity Required)
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* ... Existing styles ... */

    .history-btn {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

        .history-btn svg {
            width: 24px;
            height: 24px;
        }

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
        backdrop-filter: blur(4px);
    }

    .modal-content {
        background: white;
        width: 100%;
        max-width: 340px;
        border-radius: 20px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    }

    .modal-header {
        padding: 15px 20px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            color: #2d3436;
        }

    .close-btn {
        background: none;
        border: none;
        font-size: 24px;
        color: #b2bec3;
        line-height: 1;
        padding: 0;
    }

    .modal-body {
        padding: 20px;
        overflow-y: auto;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #b2bec3;
    }

    .empty-state svg {
        width: 48px;
        height: 48px;
        margin-bottom: 16px;
        opacity: 0.3;
    }

    .feedback-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .feedback-item {
        background: #f8f9fe;
        border-radius: 12px;
        padding: 12px;
    }

    .item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .category-badge {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        color: #667eea;
        background: rgba(102, 126, 234, 0.1);
        padding: 4px 8px;
        border-radius: 6px;
    }

    .date {
        font-size: 10px;
        color: #b2bec3;
    }

    .item-subject {
        font-size: 13px;
        font-weight: 700;
        color: #2d3436;
        margin-bottom: 4px;
    }

    .item-message {
        font-size: 11px;
        color: #636e72;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .item-footer {
        display: flex;
        justify-content: flex-end;
    }

    .status-badge {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 10px;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 6px;
    }

        .status-badge svg {
            width: 12px;
            height: 12px;
        }

        .status-badge.success {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .status-badge.warning {
            background: #fff3e0;
            color: #ef6c00;
        }

    .page-container {
        background-color: #f8f9fe;
        min-height: 100vh;
        color: #2d3436;
        font-family: 'Inter', sans-serif;
    }

    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: white;
        position: sticky;
        top: 0;
        z-index: 100;
    }

        .page-header h1 {
            font-size: 18px;
            font-weight: 700;
            margin: 0;
        }

    .header-spacer {
        width: 40px;
    }

    .back-btn {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

        .back-btn svg {
            width: 24px;
            height: 24px;
        }

    .content-area {
        padding: 20px;
    }

    .feedback-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.06);
        display: flex;
    }

    .card-accent {
        width: 6px;
        background: #667eea;
        flex-shrink: 0;
    }

    .card-body {
        padding: 20px;
        flex: 1;
    }

    .intro-text {
        font-size: 12px;
        color: #636e72;
        margin-bottom: 20px;
        line-height: 1.5;
    }

    .user-info-banner {
        background: #f0f2f5;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 24px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

        .info-item .label {
            font-size: 9px;
            font-weight: 700;
            color: #b2bec3;
            text-transform: uppercase;
        }

        .info-item .value {
            font-size: 12px;
            font-weight: 600;
            color: #2d3436;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: #636e72;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #dfe6e9;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13px;
        color: #2d3436;
        background: #fff;
        transition: border-color 0.2s;
    }

        .form-control:focus {
            border-color: #667eea;
            outline: none;
        }

    textarea.form-control {
        resize: none;
    }

    .submit-btn {
        width: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

        .submit-btn:disabled {
            opacity: 0.7;
        }

    .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .error-msg {
        color: #d63031;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .success-msg {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 12px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .success-msg svg {
            width: 18px;
            height: 18px;
        }
</style>

@code {
    private OfflineFeedback _feedback = new() { Category = "General" };
    private bool _isSaving = false;
    private bool _isSuccess = false;
    private string? _errorMessage;
    private bool _showHistoryModal = false;
    private List<OfflineFeedback> _userFeedbacks = new();

    private async Task ShowHistoryModal()
    {
        _showHistoryModal = true;
        var email = AuthService.Username ?? "";

        // Sync history from server to clean up ghosts
        await SyncService.SyncFeedbackHistoryAsync(email);

        // Fetch feedbacks for current user
        _userFeedbacks = await OfflineDb.GetUserFeedbackAsync(email);
    }

    private void CloseHistoryModal()
    {
        _showHistoryModal = false;
    }

    private async Task HandleSubmit()
    {
        Console.WriteLine("---------- [Feedback Form] Submit Started ----------");
        if (string.IsNullOrWhiteSpace(_feedback.Subject) || string.IsNullOrWhiteSpace(_feedback.Message))
        {
            Console.WriteLine("[Feedback Form] Validation Failed: Subject or Message is empty.");
            _errorMessage = "Please fill in all required fields.";
            return;
        }

        _errorMessage = null;
        _isSaving = true;

        try
        {
            Console.WriteLine($"[Feedback Form] User Info - Name: {AuthService.Fullname}, Username: {AuthService.Username}");

            _feedback.Name = AuthService.Fullname ?? "Unknown";
            _feedback.Email = AuthService.Username ?? ""; // Use username as email identifier for now
            _feedback.DateSubmitted = DateTime.Now;
            _feedback.IsSynced = false;

            Console.WriteLine($"[Feedback Form] Saving to local database... Subject: {_feedback.Subject}");
            await OfflineDb.SaveFeedbackAsync(_feedback);
            Console.WriteLine($"[Feedback Form] Save Result. New ID: {_feedback.Id}");

            // Attempt to trigger a sync immediately if online
            if (Connectivity.Current.NetworkAccess == NetworkAccess.Internet)
            {
                Console.WriteLine("[Feedback Form] Device is Online. Triggering background sync...");
                _ = Task.Run(async () =>
                {
                    try
                    {
                        Console.WriteLine("[Feedback Form] Background sync task started.");
                        await SyncService.UploadPendingDataAsync();
                        Console.WriteLine("[Feedback Form] Background sync task completed.");
                    }
                    catch (Exception bgEx)
                    {
                        Console.WriteLine($"[Feedback Form] Background sync error: {bgEx.Message}");
                    }
                });
            }
            else
            {
                Console.WriteLine("[Feedback Form] Device is Offline. Saved as draft.");
            }

            _isSuccess = true;
            _feedback = new() { Category = "General" }; // Reset form

            Console.WriteLine("[Feedback Form] Success! Displaying alert...");
            if (Application.Current?.Windows.Count > 0)
            {
                await Application.Current.Windows[0].Page!.DisplayAlert("Success", "Feedback submitted successfully!", "OK");
            }

            Console.WriteLine("[Feedback Form] Navigating to /home...");
            Navigation.NavigateTo("/feedback");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Feedback Form] CRITICAL ERROR: {ex.Message}");
            Console.WriteLine($"[Feedback Form] Stack Trace: {ex.StackTrace}");
            _errorMessage = $"Error saving feedback: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            Console.WriteLine("---------- [Feedback Form] Submit Ended ----------");
        }
    }
}
