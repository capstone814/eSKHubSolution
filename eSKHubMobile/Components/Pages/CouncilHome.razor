    private async Task SyncData()
    {
        if (Connectivity.Current.NetworkAccess != NetworkAccess.Internet)
        {
            _syncSuccess = false;
            _syncMessage = "✗ No internet connection.";
            StateHasChanged();
            await Task.Delay(3000);
            _syncMessage = string.Empty;
            StateHasChanged();
            return;
        }

        _isSyncing = true;
        _syncMessage = string.Empty;
        StateHasChanged();

        try
        {
            // Use the OfflineSyncService directly if possible, or AuthService.SyncAnnouncementsAsync
            // Actually, AuthService.SyncAnnouncementsAsync probably calls OfflineSyncService.
            // Let's check AuthService.cs in mobile.
            var syncResult = await AuthService.SyncAnnouncementsAsync();

            if (syncResult)
            {
                _syncSuccess = true;
                _syncMessage = "Sync completed successfully!";
                await LoadDataAsync();
            }
            else
            {
                _syncSuccess = false;
                _syncMessage = "Sync failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _syncSuccess = false;
            _syncMessage = $"✗ Error: {ex.Message}";
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();

            // Clear message after 3 seconds
            await Task.Delay(3000);
            _syncMessage = string.Empty;
            StateHasChanged();
        }
    }

    private async Task TriggerTestNotif()
    {
        _isNotifying = true;
        StateHasChanged();

        try
        {
            // Fire the notification immediately in the background
            var notifTask = NotifService.ShowNotificationAsync("Test Notification", "Device notifications are working correctly!");

            // Keep the spinner moving for 1 second for visual feedback
            await Task.Delay(5000);

            // Ensure the notification call is fully complete
            await notifTask;
        }
        finally
        {
            _isNotifying = false;
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true; // Ensure state is reset

            var announcementsTask = OfflineDb.GetItemsAsync<OfflineAnnouncement>();
            var programsTask = OfflineDb.GetItemsAsync<OfflineProgramProject>();
            var eventsTask = OfflineDb.GetItemsAsync<OfflineEvent>();
            var newsTask = OfflineDb.GetItemsAsync<OfflineNewsArticle>();

            await Task.WhenAll(announcementsTask, programsTask, eventsTask, newsTask);

            _announcements = (await announcementsTask ?? new List<OfflineAnnouncement>())
                                .OrderByDescending(a => a.Priority)
                                .ThenByDescending(a => a.DateCreated).ToList();

            _programs = (await programsTask ?? new List<OfflineProgramProject>())
                                .OrderByDescending(p => p.DateCreated).ToList();

            _events = (await eventsTask ?? new List<OfflineEvent>())
                                .OrderBy(e => e.EventDate)
                                .Where(e => e.EventDate >= DateTime.Today && 
                                           (string.IsNullOrEmpty(e.Audience) || 
                                            e.Audience.Equals("Public", StringComparison.OrdinalIgnoreCase) || 
                                            (e.Audience.Equals("Barangay", StringComparison.OrdinalIgnoreCase) && e.TargetBarangay == AuthService.Area)))
                                .ToList();

            _news = (await newsTask ?? new List<OfflineNewsArticle>())
                                .OrderByDescending(n => n.DateCreated).ToList();

            // Build Queue for Auto-Popups
            _popupQueue.Clear();

            // Queue Announcements
            foreach (var a in _announcements)
            {
                if (a != null && !IsItemSeen("Announcement", a.RemoteId))
                {
                    _popupQueue.Enqueue(("Announcement", a.RemoteId, a));
                }
            }

            // Queue Events
            foreach (var e in _events)
            {
                if (e != null && !IsItemSeen("Event", e.RemoteId))
                {
                    _popupQueue.Enqueue(("Event", e.RemoteId, e));
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CouncilHome] Error loading database items: {ex.Message}");
            // Fallback to empty lists if load failed to prevent render crashes
            _announcements ??= new();
            _programs ??= new();
            _events ??= new();
            _news ??= new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();

            // Start showing popups AFTER the main page has rendered
            await Task.Delay(100);
            ProcessPopupQueue();
        }
    }

    private void OnConnectivityChanged(object? sender, ConnectivityChangedEventArgs e)
    {
        _isOnline = e.NetworkAccess == NetworkAccess.Internet;
        InvokeAsync(StateHasChanged);
    }

