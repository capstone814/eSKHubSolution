    // Auto-Popup Queue
    private Queue<(string Type, int Id, object Item)> _popupQueue = new();
    private bool _isAutoPopup = false;

    private void ProcessPopupQueue()
    {
        if (_popupQueue.Count > 0)
        {
            var next = _popupQueue.Dequeue();
            _isAutoPopup = true;

            if (next.Type == "Announcement")
            {
                _selectedAnnouncement = (OfflineAnnouncement)next.Item;
            }
            else if (next.Type == "Event")
            {
                _selectedEvent = (OfflineEvent)next.Item;
            }
            // Add other types if needed, but user requested Announcements and Events.

            StateHasChanged();
        }
        else
        {
            _isAutoPopup = false;
        }
    }

    private bool IsItemSeen(string type, int id)
    {
        try
        {
            if (id <= 0) return false;
            var seenList = Preferences.Get($"seen_{type.ToLower()}s", string.Empty);
            if (string.IsNullOrEmpty(seenList)) return false;

            var seenIds = seenList.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                 .Select(s => int.TryParse(s, out var val) ? val : (int?)null)
                                 .Where(v => v.HasValue)
                                 .Select(v => v!.Value)
                                 .ToHashSet();
            return seenIds.Contains(id);
        }
        catch
        {
            return false;
        }
    }

    private void MarkItemSeen(string type, int id)
    {
        if (id <= 0) return; // Don't track invalid IDs
        var key = $"seen_{type.ToLower()}s";
        var seenList = Preferences.Get(key, string.Empty);
        var seenIds = seenList.Split(',', StringSplitOptions.RemoveEmptyEntries)
                             .Select(s => int.TryParse(s, out var val) ? val : (int?)null)
                             .Where(v => v.HasValue)
                             .Select(v => v!.Value)
                             .ToHashSet();

        if (seenIds.Add(id))
        {
            var newList = string.Join(",", seenIds);
            Preferences.Set(key, newList);
            Console.WriteLine($"[CouncilHome] Marked {type} {id} as seen. New list: {newList}");
        }
    }

