@using eSKHubMobile.Services
@using eSKHubMobile.Components.Layout
@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<Router AppAssembly="@typeof(MauiProgram).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="not-found-container">
                <div class="not-found-card">
                    <div class="error-code">404</div>
                    <div class="illustration">
                        <svg width="120" height="120" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM13 17H11V15H13V17ZM13 13H11V7H13V13Z" fill="#1e40af" fill-opacity="0.1" />
                            <path d="M11 7H13V13H11V7ZM11 15H13V17H11V15ZM12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" fill="#1e40af" />
                        </svg>
                    </div>
                    <h1>Lost in Space?</h1>
                    <p>The page you're looking for doesn't exist or has been moved to another quadrant.</p>
                    <button class="btn-primary-premium" @onclick='() => Navigation.NavigateTo("/")'>
                        Take Me Home
                    </button>
                </div>
            </div>

            <style>
                .not-found-container {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    min-height: 70vh;
                    padding: 2rem;
                    background-color: #f8fafc;
                }

                .not-found-card {
                    text-align: center;
                    max-width: 400px;
                    padding: 3rem;
                    background: white;
                    border-radius: 24px;
                    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
                }

                .error-code {
                    font-size: 5rem;
                    font-weight: 800;
                    background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    margin-bottom: 0.5rem;
                    line-height: 1;
                }

                .illustration {
                    margin-bottom: 2rem;
                    animation: float 4s ease-in-out infinite;
                }

                .not-found-card h1 {
                    font-size: 1.75rem;
                    font-weight: 700;
                    color: #1e293b;
                    margin-bottom: 1rem;
                }

                .not-found-card p {
                    color: #64748b;
                    margin-bottom: 2.5rem;
                    line-height: 1.6;
                }

                .btn-primary-premium {
                    background: linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
                    color: white;
                    border: none;
                    padding: 0.875rem 2rem;
                    border-radius: 12px;
                    font-weight: 600;
                    font-size: 1rem;
                    cursor: pointer;
                    transition: all 0.2s ease;
                    box-shadow: 0 4px 6px -1px rgba(30, 64, 175, 0.2), 0 2px 4px -2px rgba(30, 64, 175, 0.1);
                }

                    .btn-primary-premium:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 10px 15px -3px rgba(30, 64, 175, 0.3), 0 4px 6px -4px rgba(30, 64, 175, 0.2);
                        filter: brightness(1.1);
                    }

                    .btn-primary-premium:active {
                        transform: translateY(0);
                    }

                @@keyframes float {
                    0%, 100% {
                        transform: translateY(0);
                    }

                    50% {
                        transform: translateY(-10px);
                    }
                }
            </style>
        </LayoutView>
    </NotFound>
</Router>

<PermissionBarrier />

@code {
    protected override void OnInitialized()
    {
        // Subscribe to auth changes
        AuthService.OnAuthStateChanged += HandleAuthChange;

        // Redirect to login if not authenticated
        if (!AuthService.IsAuthenticated && !Navigation.Uri.Contains("/login"))
        {
            Navigation.NavigateTo("/login");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !AuthService.IsAuthenticated && !Navigation.Uri.Contains("/login"))
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void HandleAuthChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= HandleAuthChange;
    }
}