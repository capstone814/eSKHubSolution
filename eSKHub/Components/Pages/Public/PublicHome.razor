@code {
    private Announcement? _latestAnnouncement;
    private NewsArticle? _latestNews;
    private NewsArticle? _secondNews;
    private NewsArticle? _thirdNews;

    private List<ProgramProject> _allPrograms = new();
    private List<ProgramProject> _filteredPrograms = new();
    private string _selectedCategory = "All";

    private List<Event> _upcomingEvents = new();

    private int _totalProgramsCount = 0;
    private int _totalYouthCount = 0;
    private int _totalEventsCount = 0;
    private int _activeVolunteersCount = 0;

    private bool _hasActivePolls = false;
    private int _activePollCount = 0;
    private HashSet<int> _votedPollIds = new();

    private int _budgetDocsCount = 0;
    private int _resolutionDocsCount = 0;
    private int _performanceDocsCount = 0;
    private int _procurementDocsCount = 0;

    private async Task LoadTransparencyDocumentCounts()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            _budgetDocsCount = await db.TransparencyDocuments
                .Where(t => t.IsPublished && t.Category == "Budget")
                .CountAsync();

            _resolutionDocsCount = await db.TransparencyDocuments
                .Where(t => t.IsPublished && t.Category == "Resolution")
                .CountAsync();

            _performanceDocsCount = await db.TransparencyDocuments
                .Where(t => t.IsPublished && t.Category == "Performance")
                .CountAsync();

            _procurementDocsCount = await db.TransparencyDocuments
                .Where(t => t.IsPublished && t.Category == "Procurement")
                .CountAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading transparency document counts: {ex.Message}");
        }
    }

    private void NavigateToTransparency(string category)
    {
        NavigationManager.NavigateTo($"/transparency?category={category}");
    }

    private async Task ViewTransparencyDocuments(string category)
    {
        var parameters = new DialogParameters
    {
        { "Category", category }
    };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        await DialogService.ShowAsync<ViewTransparencyDocumentsDialog>(
            $"{category} Documents",
            parameters,
            options
        );
    }

    private async Task LoadStatistics()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            // Count total registered youth
            _totalYouthCount = await db.Youths
                .Where(y => y.Status == "Active")
                .CountAsync();

            // Count total events
            _totalEventsCount = await db.Events
                .Where(e => e.IsPublished)
                .CountAsync();

            // Count active volunteers (youth willing to volunteer)
            _activeVolunteersCount = await db.Youths
                .Where(y => y.Status == "Active" && y.WillingToVolunteer)
                .CountAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading statistics: {ex.Message}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLatestAnnouncement();
        await LoadLatestNews();
        await LoadPrograms();
        await LoadUpcomingEvents();
        await LoadProgramsCount();
        await LoadStatistics();
        await LoadVotedPolls();
        await CheckForActivePolls();
        await LoadTransparencyDocumentCounts();
        ThemeService.OnThemeChanged += StateHasChanged;
    }


    private async Task LoadVotedPolls()
    {
        try
        {
            var votedPolls = await SessionStorage.GetItemAsync<List<int>>("voted_polls_public");
            if (votedPolls != null)
            {
                _votedPollIds = new HashSet<int>(votedPolls);
            }
        }
        catch
        {
            _votedPollIds = new HashSet<int>();
        }
    }

    private async Task CheckForActivePolls()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var activePolls = await db.Polls
                .Where(p => p.IsActive &&
                           (!p.DateExpires.HasValue || p.DateExpires.Value > DateTime.Now) &&
                           p.Audience == "Public")
                .Select(p => p.Id)
                .ToListAsync();

            // ✅ Filter out already voted polls
            var unansweredPolls = activePolls.Where(id => !_votedPollIds.Contains(id)).ToList();

            _activePollCount = unansweredPolls.Count;
            _hasActivePolls = _activePollCount > 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking polls: {ex.Message}");
        }
    }

    private async Task LoadLatestAnnouncement()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _latestAnnouncement = await db.Announcements
                .Where(a => a.IsPublished && a.Audience == "Public")
                .OrderByDescending(a => a.DateCreated)
                .FirstOrDefaultAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading latest announcement: {ex.Message}");
        }
    }

    private async Task LoadProgramsCount()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _totalProgramsCount = await db.ProgramsProjects
                .Where(p => p.IsPublished && p.Status == "Approved")
                .CountAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading programs count: {ex.Message}");
        }
    }

    private async Task LoadLatestNews()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var newsArticles = await db.NewsArticles
                .Where(n => n.IsPublished)
                .OrderByDescending(n => n.DateCreated)
                .Take(3)
                .ToListAsync();

            if (newsArticles.Any())
            {
                _latestNews = newsArticles.ElementAtOrDefault(0);
                _secondNews = newsArticles.ElementAtOrDefault(1);
                _thirdNews = newsArticles.ElementAtOrDefault(2);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading latest news: {ex.Message}");
        }
    }

    private async Task LoadUpcomingEvents()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _upcomingEvents = await db.Events
                .Where(e => e.IsPublished &&
                           e.Audience == "Public" &&
                           e.EventDate.Date >= DateTime.Today)
                .OrderBy(e => e.EventDate)
                .Take(3)
                .AsNoTracking()
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading upcoming events: {ex.Message}");
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }

    private Color GetEventTypeColor(string eventType) => eventType switch
    {
        "Meeting" => Color.Info,
        "Sports" => Color.Success,
        "Community" => Color.Primary,
        "Workshop" => Color.Warning,
        "Training" => Color.Error,
        "Cultural" => Color.Secondary,
        _ => Color.Default
    };

    private Color GetNewsTypeChipColor(string newsType) => newsType switch
    {
        "Breaking" => Color.Error,
        "Feature" => Color.Primary,
        "Community" => Color.Success,
        "Event" => Color.Info,
        "Achievement" => Color.Warning,
        _ => Color.Default
    };

    private string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;

        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} minute{((int)timeSpan.TotalMinutes != 1 ? "s" : "")} ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} hour{((int)timeSpan.TotalHours != 1 ? "s" : "")} ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays} day{((int)timeSpan.TotalDays != 1 ? "s" : "")} ago";
        if (timeSpan.TotalDays < 30)
            return $"{(int)(timeSpan.TotalDays / 7)} week{((int)(timeSpan.TotalDays / 7) != 1 ? "s" : "")} ago";
        if (timeSpan.TotalDays < 365)
            return $"{(int)(timeSpan.TotalDays / 30)} month{((int)(timeSpan.TotalDays / 30) != 1 ? "s" : "")} ago";

        return $"{(int)(timeSpan.TotalDays / 365)} year{((int)(timeSpan.TotalDays / 365) != 1 ? "s" : "")} ago";
    }

    private void NavigateToNews(int newsId)
    {
        NavigationManager.NavigateTo($"/news?id={newsId}");
    }

    private async Task LoadPrograms()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _allPrograms = await db.ProgramsProjects
                .Where(p => p.IsPublished && p.Status == "Approved" && p.Audience == "Public")
                .OrderByDescending(p => p.DateCreated)
                .Take(8)
                .AsNoTracking()
                .ToListAsync();

            _filteredPrograms = _allPrograms;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading programs: {ex.Message}");
        }
    }

    private void FilterByCategory(string category)
    {
        _selectedCategory = category;

        if (category == "All")
        {
            _filteredPrograms = _allPrograms;
        }
        else
        {
            _filteredPrograms = _allPrograms
                .Where(p => p.Category == category)
                .ToList();
        }

        StateHasChanged();
    }

    private (string BorderColor, string BackgroundColor, string TextColor) GetCategoryStyles(string category)
    {
        return category switch
        {
            "Youth Development" => ("#7e6fff", "rgba(126, 111, 255, 0.1)", "#7e6fff"),
            "Environment" => ("#10b981", "rgba(16, 185, 129, 0.1)", "#10b981"),
            "Sports" => ("#3b82f6", "rgba(59, 130, 246, 0.1)", "#3b82f6"),
            "Employment" => ("#f59e0b", "rgba(245, 158, 11, 0.1)", "#f59e0b"),
            "Health" => ("#ef4444", "rgba(239, 68, 68, 0.1)", "#ef4444"),
            _ => ("#6b7280", "rgba(107, 114, 128, 0.1)", "#6b7280")
        };
    }
    private async Task OpenYouthRegistrationDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<YouthRegistrationDialog>("Youth Registration", options);
    }
    private async Task OpenSubmitFeedbackDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<SubmitFeedbackDialog>("Submit Feedback", options);
    }

    private void ViewProgramDetails(int programId)
    {
        NavigationManager.NavigateTo($"/programs?id={programId}");
    }
    private async Task OpenTakeSurveyDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TakeSurveyDialog>("Community Polls", options);
        var result = await dialog.Result;

        // ✅ Refresh poll count after dialog closes with null-conditional operator
        if (!(result?.Canceled ?? true))
        {
            await LoadVotedPolls();
            await CheckForActivePolls();
            StateHasChanged();
        }
    }
}