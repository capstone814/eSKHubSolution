@page "/"
@layout eSKHub.Components.Layout.PublicPageLayout
@using eSKHub.Components.Model
@using eSKHub.Components.Services
@using Microsoft.EntityFrameworkCore
@using eSKHub.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject IDbContextFactory<eSKHub.Model.AppDbContext> DbFactory
@inject ThemeService ThemeService
@inject NavigationManager NavigationManager
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@implements IDisposable

<PageTitle>eSKHub Bacacay</PageTitle>

<style>
    .mud-main-content {
        padding-top: 0 !important;
    }
</style>

<div class="public-home-page">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <!-- Header with Background Image -->
        <div class="header-with-image">
            <div class="header-overlay">
                <div class="header-content">
                    <div class="header-logos">
                        <img src="/website/SKBACACAYLOGO.png" alt="SK Logo" class="@(ThemeService.IsDarkMode ? "header-logo-img-dark" : "header-logo-img-light")" />
                        <div class="@(ThemeService.IsDarkMode ? "header-text-dark" : "header-text-light")">
                            <MudText Typo="Typo.h2">SANGGUNIANG KABATAAN</MudText>
                            <MudText Typo="Typo.h4">OF</MudText>
                            <MudText Typo="Typo.h2">BACACAY, ALBAY</MudText>
                        </div>
                        <img src="/website/LGUBACACAYLOGO.png" alt="Bacacay Logo" class="@(ThemeService.IsDarkMode ? "header-logo-img-dark" : "header-logo-img-light")" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Hero Banner -->
        <div class="hero-banner" id="announcements">
            <div class="hero-content">
                @if (_latestAnnouncement != null)
                {
                    <div class="hero-badge">🎉 Latest Announcement</div>
                    <h1 class="hero-title">@_latestAnnouncement.Subject</h1>
                    <p class="hero-description">@_latestAnnouncement.ShortDescription</p>
                    <div class="hero-buttons">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Surface"
                                   Size="Size.Large"
                                   Style="color: #ffffff; font-weight: 600; background-color: #667eea;"
                                   Href="/announcements?autoselect=true">
                            Learn More
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Large"
                                   Style="color: white; border-color: rgba(255,255,255,0.5); font-weight: 600;"
                                   Href="/announcements">
                            View All Updates
                        </MudButton>
                    </div>
                }
                else
                {
                    <div class="hero-badge">🎉 Welcome</div>
                    <h1 class="hero-title">No Announcements Available</h1>
                    <p class="hero-description">Check back soon for the latest updates from your Sangguniang Kabataan Chapter.</p>
                    <div class="hero-buttons">
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Large"
                                   Style="color: white; border-color: rgba(255,255,255,0.5); font-weight: 600;"
                                   Href="/announcements">
                            View All Updates
                        </MudButton>
                    </div>
                }
            </div>
            <div class="hero-gradient-overlay"></div>
        </div>

        <!-- Quick Actions -->
        <MudGrid Class="section-spacing">
            <MudItem xs="12">
                <MudText Typo="Typo.h4" Class="section-title">Quick Actions</MudText>
                <MudText Class="section-description">Get started with these common tasks</MudText>
            </MudItem>
            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="quick-action-card pa-6"
                          Elevation="2"
                          Style="cursor: pointer;"
                          @onclick="OpenSubmitFeedbackDialog">
                    <MudIcon Icon="@Icons.Material.Filled.Feedback" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 600;">Submit Feedback</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Share your ideas</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="quick-action-card pa-6"
                          Elevation="2"
                          Style="cursor: pointer;"
                          @onclick="OpenYouthRegistrationDialog">
                    <MudIcon Icon="@Icons.Material.Filled.HowToReg" Color="Color.Secondary" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 600;">Youth Registration</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Join our database</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="quick-action-card pa-6"
                          Elevation="2"
                          Style="cursor: pointer;"
                          @onclick="@(() => NavigationManager.NavigateTo("/events"))">
                    <MudIcon Icon="@Icons.Material.Filled.Event" Color="Color.Success" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 600;">Events Calendar</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Upcoming activities</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="6" md="3">
                <MudPaper Class="quick-action-card pa-6" Elevation="2" Style="cursor: pointer;">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Warning" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 600;">Transparency Hub</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">View reports</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Programs & Projects -->
        <MudGrid Class="section-spacing" id="programs">
            <MudItem xs="12">
                <MudText Typo="Typo.h4" Class="section-title">Programs & Projects</MudText>
                <MudText Class="section-description">Initiatives driving positive change in our community</MudText>
                <div class="category-filters">
                    <button class="filter-chip @(_selectedCategory == "All" ? "active" : "")"
                            @onclick="@(() => FilterByCategory("All"))">
                        All
                    </button>

                    <button class="filter-chip @(_selectedCategory == "Youth Development" ? "active" : "")"
                            @onclick="@(() => FilterByCategory("Youth Development"))">
                        Youth Dev
                    </button>

                    <button class="filter-chip @(_selectedCategory == "Environment" ? "active" : "")"
                            @onclick="@(() => FilterByCategory("Environment"))">
                        Environment
                    </button>

                    <button class="filter-chip @(_selectedCategory == "Sports" ? "active" : "")"
                            @onclick="@(() => FilterByCategory("Sports"))">
                        Sports
                    </button>

                    <button class="filter-chip @(_selectedCategory == "Employment" ? "active" : "")"
                            @onclick="@(() => FilterByCategory("Employment"))">
                        Employment
                    </button>

                    <button class="filter-chip @(_selectedCategory == "Health" ? "active" : "")"
                            @onclick="@(() => FilterByCategory("Health"))">
                        Health
                    </button>
                </div>
            </MudItem>

            @if (_filteredPrograms.Any())
            {
                @foreach (var program in _filteredPrograms.Take(4))
                {
                    var styles = GetCategoryStyles(program.Category);
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="program-card pa-4"
                                  Elevation="2"
                                  Style="@($"border-left-color: {styles.BorderColor};")">
                            <span class="program-category"
                                  style="@($"background: {styles.BackgroundColor}; color: {styles.TextColor};")">
                                @program.Category
                            </span>
                            <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight: 600;">
                                @program.Title
                            </MudText>
                            <MudText Typo="Typo.body2"
                                     Color="Color.Secondary"
                                     Class="mb-3"
                                     Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @program.Description
                            </MudText>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       EndIcon="@Icons.Material.Filled.ChevronRight"
                                       OnClick="@(() => ViewProgramDetails(program.Id))">
                                Learn More
                            </MudButton>
                        </MudPaper>
                    </MudItem>
                }
            }
            else
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-8" Elevation="0" Style="text-align: center;">
                        <MudIcon Icon="@Icons.Material.Filled.Work"
                                 Size="Size.Large"
                                 Color="Color.Secondary"
                                 Style="font-size: 64px; opacity: 0.3; margin-bottom: 16px;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Style="margin-bottom: 8px;">
                            No Programs Available
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @if (_selectedCategory != "All")
                            {
                                <text>No programs found in the @_selectedCategory category. Try selecting a different category.</text>
                            }
                            else
                            {
                                <text>Check back soon for upcoming programs and projects from your Sangguniang Kabataan.</text>
                            }
                        </MudText>
                    </MudPaper>
                </MudItem>
            }
            <MudItem xs="12" Style="margin-top: 16px;">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           EndIcon="@Icons.Material.Filled.ChevronRight"
                           Href="/programs">
                    View All Programs & Projects
                </MudButton>
            </MudItem>
        </MudGrid>

        <!-- Statistics -->
        <MudGrid Class="section-spacing">
            <MudItem xs="12">
                <MudText Typo="Typo.h4" Class="section-title">Our Impact</MudText>
                <MudText Class="section-description">Making a difference in our community</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="stats-card" Elevation="2">
                    <div class="stats-number">@_totalYouthCount</div>
                    <div class="stats-label">Registered Youth</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="stats-card" Elevation="2">
                    <div class="stats-number">@_totalProgramsCount</div>
                    <div class="stats-label">Programs</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="stats-card" Elevation="2">
                    <div class="stats-number">@_totalEventsCount</div>
                    <div class="stats-label">Events</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudPaper Class="stats-card" Elevation="2">
                    <div class="stats-number">@_activeVolunteersCount</div>
                    <div class="stats-label">Active Volunteers</div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Upcoming Events -->
        <MudGrid Class="section-spacing" id="events">
            <MudItem xs="12">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <MudText Typo="Typo.h4" Class="section-title">Upcoming Events</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.Event" Style="color: #764ba2;" Size="Size.Large" />
                </div>
            </MudItem>
            @if (_upcomingEvents.Any())
            {
                @foreach (var evt in _upcomingEvents.Take(3))
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Elevation="2" Class="pa-4" Style="border-radius: 16px; height: 100%;">
                            <div style="display: flex; gap: 16px; align-items: start;">
                                <div class="event-date-box">
                                    <div class="event-date-month">@evt.EventDate.ToString("MMM")</div>
                                    <div class="event-date-day">@evt.EventDate.Day</div>
                                </div>
                                <div style="flex: 1;">
                                    <MudText Typo="Typo.h6" Style="font-weight: 600; margin-bottom: 4px;">@evt.Title</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetEventTypeColor(evt.EventType)">@evt.EventType</MudChip>
                                </div>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            }
            else
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-8" Elevation="0" Style="text-align: center;">
                        <MudIcon Icon="@Icons.Material.Filled.Event"
                                 Size="Size.Large"
                                 Color="Color.Secondary"
                                 Style="font-size: 64px; opacity: 0.3; margin-bottom: 16px;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Style="margin-bottom: 8px;">
                            No Upcoming Events
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Check back soon for upcoming events and activities from your Sangguniang Kabataan.
                        </MudText>
                    </MudPaper>
                </MudItem>
            }
            <MudItem xs="12">
                <MudButton Variant="Variant.Outlined"
                           style="color: #764ba2;border-color:#764ba2;"
                           FullWidth="true"
                           Href="/events">
                    View Full Calendar
                </MudButton>
            </MudItem>
        </MudGrid>

        <!-- Latest News & Updates -->
        <MudGrid Class="section-spacing" id="news">
            <MudItem xs="12">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <MudText Typo="Typo.h4" Class="section-title">What's New</MudText>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ChevronRight"
                               Href="/news"
                               Style="display: none;"
                               Class="view-all-news-btn">
                        View All News
                    </MudButton>
                </div>
            </MudItem>

            @if (_latestNews != null)
            {
                <!-- Featured News Card -->
                <MudItem xs="12">
                    <MudPaper Class="news-card-featured pa-6"
                              Elevation="0">
                        <MudChip T="string"
                                 Color="@GetNewsTypeChipColor(_latestNews.NewsType)"
                                 Size="Size.Small"
                                 Style="background: rgba(255,255,255,0.2); color: white;">
                            @_latestNews.NewsType
                        </MudChip>
                        <MudText Typo="Typo.body2" Style="color: white; opacity: 0.9; margin-top: 8px;">
                            @GetTimeAgo(_latestNews.DateCreated)
                        </MudText>
                        <MudText Typo="Typo.h5" Style="color: white; font-weight: 600; margin: 16px 0;">
                            @_latestNews.Title
                        </MudText>
                        <MudText Typo="Typo.body1" Style="color: white; opacity: 0.95; margin-bottom: 16px;">
                            @_latestNews.Summary
                        </MudText>
                        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                            <MudButton Variant="Variant.Text"
                                       Style="color: white;"
                                       EndIcon="@Icons.Material.Filled.ChevronRight"
                                       OnClick="@(() => NavigateToNews(_latestNews.Id))">
                                Read Full Article
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Style="color: white; border-color: rgba(255,255,255,0.5);"
                                       Href="/news">
                                View All News
                            </MudButton>
                        </div>
                    </MudPaper>
                </MudItem>

                @if (_secondNews != null)
                {
                    <MudItem xs="12" sm="6">
                        <MudPaper Class="news-card-small pa-4"
                                  Elevation="1"
                                  Style="cursor: pointer; height: 100%;"
                                  @onclick="@(() => NavigateToNews(_secondNews.Id))">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @GetTimeAgo(_secondNews.DateCreated)
                            </MudText>
                            <MudText Typo="Typo.h6" Style="font-weight: 600; margin: 8px 0;">
                                @_secondNews.Title
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @_secondNews.Summary
                            </MudText>
                        </MudPaper>
                    </MudItem>
                }

                @if (_thirdNews != null)
                {
                    <MudItem xs="12" sm="6">
                        <MudPaper Class="news-card-small pa-4"
                                  Elevation="1"
                                  Style="cursor: pointer; height: 100%;"
                                  @onclick="@(() => NavigateToNews(_thirdNews.Id))">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @GetTimeAgo(_thirdNews.DateCreated)
                            </MudText>
                            <MudText Typo="Typo.h6" Style="font-weight: 600; margin: 8px 0;">
                                @_thirdNews.Title
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @_thirdNews.Summary
                            </MudText>
                        </MudPaper>
                    </MudItem>
                }
            }
            else
            {
                <!-- Empty State -->
                <MudItem xs="12">
                    <MudPaper Class="pa-8" Elevation="0" Style="text-align: center; background: var(--mud-palette-surface);">
                        <MudIcon Icon="@Icons.Material.Filled.Article"
                                 Size="Size.Large"
                                 Color="Color.Secondary"
                                 Style="font-size: 64px; opacity: 0.3; margin-bottom: 16px;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Style="margin-bottom: 8px;">
                            No News Articles Yet
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="margin-bottom: 24px;">
                            Check back soon for the latest updates and stories from your Sangguniang Kabataan Bacacay Chapter.
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Style="border: 1px solid #667eea; color: #667eea;"
                                   Href="/news">
                            Go to News Page
                        </MudButton>

                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <!-- Transparency & Accountability Section -->
        <div class="transparency-section" id="transparency">
            <div style="position: relative; z-index: 10;">
                <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" />
                    <MudText Typo="Typo.h4" Class="section-title">Transparency & Accountability</MudText>
                </div>
                <MudText Typo="Typo.h6" Style="opacity: 0.9; margin-bottom: 32px; max-width: 700px;">
                    Access detailed reports on budget utilization, resolutions, procurement processes, and performance metrics.
                </MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <div class="transparency-card" style="cursor: pointer;" @onclick="@(() => NavigateToTransparency("Budget"))">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Class="card-icon" />
                            <div>
                                <MudText Typo="Typo.h6" Class="title">Budget Reports</MudText>
                                <MudText Typo="Typo.body2" Class="desc">Fund allocation & spending</MudText>
                                @if (_budgetDocsCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="margin-top: 8px;">
                                        @_budgetDocsCount documents
                                    </MudChip>
                                }
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <div class="transparency-card" style="cursor: pointer;" @onclick="@(() => NavigateToTransparency("Resolution"))">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Class="card-icon" />
                            <div>
                                <MudText Typo="Typo.h6" Class="title">Resolutions</MudText>
                                <MudText Typo="Typo.body2" Class="desc">Passed ordinances archive</MudText>
                                @if (_resolutionDocsCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="margin-top: 8px;">
                                        @_resolutionDocsCount documents
                                    </MudChip>
                                }
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <div class="transparency-card" style="cursor: pointer;" @onclick="@(() => NavigateToTransparency("Performance"))">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Class="card-icon" />
                            <div>
                                <MudText Typo="Typo.h6" Class="title">Performance</MudText>
                                <MudText Typo="Typo.body2" Class="desc">SK scorecard metrics</MudText>
                                @if (_performanceDocsCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="margin-top: 8px;">
                                        @_performanceDocsCount documents
                                    </MudChip>
                                }
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <div class="transparency-card" style="cursor: pointer;" @onclick="@(() => NavigateToTransparency("Procurement"))">
                            <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Large" Class="card-icon" />
                            <div>
                                <MudText Typo="Typo.h6" Class="title">Procurement</MudText>
                                <MudText Typo="Typo.body2" Class="desc">Bidding notices</MudText>
                                @if (_procurementDocsCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Style="margin-top: 8px;">
                                        @_procurementDocsCount documents
                                    </MudChip>
                                }
                            </div>
                        </div>
                    </MudItem>
                </MudGrid>
            </div>
        </div>

        <!-- Get Involved -->
        <MudGrid Class="section-spacing" id="get-involved">
            <MudItem xs="12">
                <MudText Typo="Typo.h4" Class="section-title" Align="Align.Center">Get Involved</MudText>
                <MudText Class="section-description" Align="Align.Center" Style="max-width: 600px; margin: 0 auto 32px;">Your voice matters. Join us in shaping the future of our community through active participation.</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="engagement-card engagement-card-blue">
                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 600;">Share Your Ideas</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="opacity: 0.9;">Submit project suggestions and feedback to help improve our programs.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Surface" FullWidth="true" Style="color: #ffffff; font-weight: 600; background-color: #2b6cb0" OnClick="OpenSubmitFeedbackDialog">Submit Feedback</MudButton>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="engagement-card engagement-card-purple">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 600;">Join Our Database</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="opacity: 0.9;">Register as a youth member to receive updates and participate in programs.</MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Surface"
                               FullWidth="true"
                               Style="color: #ffffff; font-weight: 600; background-color: #6b46c1;"
                               OnClick="OpenYouthRegistrationDialog">
                        Register Now
                    </MudButton>
                </div>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="engagement-card engagement-card-pink" style="position: relative;">
                    @if (_hasActivePolls)
                    {
                        <MudBadge Content="@_activePollCount"
                                  Color="Color.Error"
                                  Overlap="true"
                                  Style="position: absolute; top: 16px; right: 16px;">
                        </MudBadge>
                    }
                    <MudIcon Icon="@Icons.Material.Filled.HowToVote" Size="Size.Large" Class="mb-3" />
                    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 600;">Vote on Priorities</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="opacity: 0.9;">Participate in polls and surveys to help us prioritize community programs.</MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Surface"
                               FullWidth="true"
                               Style="color: #ffffff; font-weight: 600; background-color: #b83280;"
                               OnClick="OpenTakeSurveyDialog">
                        Take Survey
                    </MudButton>
                </div>
            </MudItem>
