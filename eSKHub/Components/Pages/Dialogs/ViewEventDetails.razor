@using eSKHub.Components.Model
@using eSKHub.Model
@using eSKHub.Components.Services
@using eSKHub.Components.Dialogs
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject AppDbContext Db
@inject UserStateService UserState
@inject IDialogService DialogService

<style>
    .event-details-dialog .mud-dialog-content {
        padding: 16px;
    }

    .event-details-dialog .mud-dialog-actions {
        padding: 12px 16px;
        gap: 8px;
    }

    .event-chip-stack {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
    }

    .icon-text-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
    }

        .icon-text-row .mud-icon-root {
            vertical-align: middle;
        }

    @@media (max-width: 600px) {
        .event-details-dialog .mud-dialog-content {
            padding: 12px;
        }

        .event-details-dialog .mud-typography-h5 {
            font-size: 1.25rem !important;
        }

        .event-details-dialog .mud-typography-subtitle2 {
            font-size: 0.9rem !important;
        }

        .event-details-dialog .mud-typography-body2 {
            font-size: 0.875rem !important;
        }

        .event-details-dialog .mud-typography-caption {
            font-size: 0.75rem !important;
        }

        .event-chip-stack {
            gap: 6px;
        }

            .event-chip-stack .mud-chip {
                font-size: 0.75rem !important;
                height: 24px !important;
            }

        .event-details-dialog .mud-dialog-actions {
            flex-direction: column;
            padding: 12px;
            gap: 8px;
        }

            .event-details-dialog .mud-dialog-actions .mud-button-root {
                width: 100%;
                justify-content: center;
            }

        .event-details-dialog .mud-grid {
            margin: 0 !important;
        }

        .event-details-dialog .mud-grid-item {
            padding: 8px !important;
        }

        .event-details-dialog .mud-icon-root.mud-icon-size-small {
            font-size: 1rem !important;
        }
    }
</style>

<MudDialog Class="event-details-dialog" MaxWidth="MaxWidth.Medium" FullWidth="true" Style="border-top: 5px solid #7e6fff; border-left: 3px solid #7e6fff; border-radius:4px;">
    <TitleContent>
        EVENT DETAILS
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudText Typo="Typo.h5" Style="font-weight: 600;">@EventToView.Title</MudText>
                <div class="event-chip-stack">
                    <MudChip T="string" Size="Size.Small" Color="@GetEventTypeColor(EventToView.EventType)">
                        @EventToView.EventType
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@(EventToView.IsPublished? Color.Success: Color.Default)">
                        @(EventToView.IsPublished ? "Published" : "Draft")
                    </MudChip>
                    @if (EventToView.Audience == "Barangay")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                            @EventToView.TargetBarangay
                        </MudChip>
                    } else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                            Public
                        </MudChip>
                    }
                </div>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Description</MudText>
                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@EventToView.Description</MudText>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Date & Time</MudText>
                <div class="icon-text-row">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@EventToView.EventDate.ToString("MMMM dd, yyyy (dddd)")</MudText>
                </div>
                @if (EventToView.StartTime.HasValue)
                {
                    <div class="icon-text-row">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@GetTimeDisplay(EventToView.StartTime, EventToView.EndTime)</MudText>
                    </div>
                }
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Location</MudText>
                <div class="icon-text-row">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@EventToView.Location</MudText>
                </div>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Organizer</MudText>
                <MudText Typo="Typo.body2">
                    @EventToView.Organizer (@EventToView.OrganizerPosition - @EventToView.OrganizerArea)
                </MudText>
            </MudItem>

            @if (!string.IsNullOrWhiteSpace(EventToView.Notes))
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Additional Notes</MudText>
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@EventToView.Notes</MudText>
                </MudItem>
            }

            <MudItem xs="12">
                <MudDivider />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                    Created: @EventToView.DateCreated.ToString("MMM dd, yyyy • hh:mm tt")
                    @if (EventToView.DateModified.HasValue)
                    {
                        <text> • Updated: @EventToView.DateModified.Value.ToString("MMM dd, yyyy • hh:mm tt")</text>
                    }
                </MudText>
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Close</MudButton>

        @if (CanEdit)
        {
            <MudButton Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EditEvent"
                       Variant="Variant.Filled">
                Edit
            </MudButton>
        }

        @if (_canPublish)
        {
            <MudButton Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Visibility"
                       OnClick="PublishEvent"
                       Variant="Variant.Filled">
                Publish
            </MudButton>
        }

        @if (_canUnpublish)
        {
            <MudButton Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.VisibilityOff"
                       OnClick="UnpublishEvent"
                       Variant="Variant.Filled">
                Unpublish
            </MudButton>
        }

        @if (_canDelete)
        {
            <MudButton Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteEvent"
                       Variant="Variant.Filled">
                Delete
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Event EventToView { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; } = false;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _isAdmin = false;
    private bool _canPublish = false;
    private bool _canUnpublish = false;
    private bool _canDelete = false;

    protected override async Task OnInitializedAsync()
    {
        await UserState.InitializeAsync();

        // Check if user is admin
        var currentUser = await Db.Users.FirstOrDefaultAsync(u => u.Username == UserState.Username);
        _isAdmin = currentUser?.Role == "Admin";

        var isOwnEvent = EventToView.Organizer == (UserState.Fullname ?? "");

        // Edit permissions:
        // - Council: Can only edit own events
        // - Admin: Can edit all events
        CanEdit = (isOwnEvent || _isAdmin) && !EventToView.IsPublished;

        // Publish/Unpublish permissions:
        // - For own barangay events (council): can publish/unpublish freely
        // - For own public events (council): cannot publish (only admin can)
        // - For any events (admin): can publish/unpublish
        if (_isAdmin)
        {
            // Admin can publish/unpublish any event
            _canPublish = !EventToView.IsPublished;
            _canUnpublish = EventToView.IsPublished;
        }
        else if (isOwnEvent)
        {
            // Council user with own event
            if (EventToView.Audience == "Barangay")
            {
                // Barangay events: council can publish/unpublish
                _canPublish = !EventToView.IsPublished;
                _canUnpublish = EventToView.IsPublished;
            }
            else // Public events
            {
                // Public events: council cannot publish (only admin can)
                _canPublish = false;
                _canUnpublish = false;
            }
        }
        else
        {
            // Not own event and not admin: no publish permissions
            _canPublish = false;
            _canUnpublish = false;
        }

        // Delete permissions:
        // - Council: can only delete own events
        // - Admin: can delete all events
        _canDelete = isOwnEvent || _isAdmin;
    }

    private Color GetEventTypeColor(string eventType) => eventType switch
    {
        "Meeting" => Color.Info,
        "Sports" => Color.Success,
        "Community" => Color.Primary,
        "Workshop" => Color.Warning,
        "Training" => Color.Error,
        "Cultural" => Color.Secondary,
        _ => Color.Default
    };

    private async Task EditEvent()
    {
        DialogOptions options;
        IDialogReference dialog;

        if (_isAdmin)
        {
            // Admin uses EditEventForm
            var parameters = new DialogParameters { { "EventToEdit", EventToView } };
            options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            dialog = await DialogService.ShowAsync<EditEventForm>("Edit Event", parameters, options);
        }
        else
        {
            // Council users use CouncilEditEventForm
            var parameters = new DialogParameters { { "EventToEdit", EventToView } };
            options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            dialog = await DialogService.ShowAsync<CouncilEditEventForm>("Edit Event", parameters, options);
        }

        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            Snackbar.Add("Event updated successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private async Task PublishEvent()
    {
        using var db = await Db.Database.BeginTransactionAsync();
        var eventInDb = await Db.Events.FindAsync(EventToView.Id);
        if (eventInDb != null)
        {
            eventInDb.IsPublished = true;
            await Db.SaveChangesAsync();
            await db.CommitAsync();
            Snackbar.Add("Event published successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private async Task UnpublishEvent()
    {
        using var db = await Db.Database.BeginTransactionAsync();
        var eventInDb = await Db.Events.FindAsync(EventToView.Id);
        if (eventInDb != null)
        {
            eventInDb.IsPublished = false;
            await Db.SaveChangesAsync();
            await db.CommitAsync();
            Snackbar.Add("Event unpublished!", Severity.Info);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private async Task DeleteEvent()
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Are you sure you want to delete '{EventToView.Title}'? This action cannot be undone." },
            { "ButtonText", "Delete" },
            { "Color", Color.Error }
        };

        var dialogRef = await DialogService.ShowAsync<ConfirmDialog>("Confirm Delete", parameters);
        var result = await dialogRef.Result;

        if (!(result?.Canceled ?? true))
        {
            var eventToDelete = await Db.Events.FindAsync(EventToView.Id);
            if (eventToDelete != null)
            {
                Db.Events.Remove(eventToDelete);
                await Db.SaveChangesAsync();
                Snackbar.Add("Event deleted successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
    }

    private string GetTimeDisplay(TimeSpan? startTime, TimeSpan? endTime)
    {
        if (startTime == null && endTime == null)
            return "All day event";

        if (startTime.HasValue && endTime.HasValue)
        {
            return $"{FormatTime(startTime.Value)} - {FormatTime(endTime.Value)}";
        }

        if (startTime.HasValue)
            return $"Starts at {FormatTime(startTime.Value)}";

        if (endTime.HasValue)
            return $"Ends at {FormatTime(endTime.Value)}";

        return "All day event";
    }

    private string FormatTime(TimeSpan time)
    {
        var hours = time.Hours;
        var minutes = time.Minutes;
        var period = hours >= 12 ? "PM" : "AM";

        if (hours > 12)
            hours -= 12;
        else if (hours == 0)
            hours = 12;

        return $"{hours}:{minutes:D2} {period}";
    }

    private void Close() => MudDialog.Close();
}