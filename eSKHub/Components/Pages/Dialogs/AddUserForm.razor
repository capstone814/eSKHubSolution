@using eSKHub.Components.Model
@using eSKHub.Model
@using System.Security.Cryptography;
@using System.Text;
@using System.Text.RegularExpressions;
@using SixLabors.ImageSharp;
@using SixLabors.ImageSharp.Processing;
@using SixLabors.ImageSharp.Formats.Jpeg;
@using SixLabors.ImageSharp.Formats.Png;
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject AppDbContext Db

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Style="border-top: 5px solid #7e6fff; border-left: 3px solid #7e6fff; border-radius:4px;">
    <TitleContent>
        ADD USER
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_newUser">

            <MudText Typo="Typo.subtitle2" Class="mb-2" Align="Align.Center">Upload Profile Image</MudText>

            <div style="display: flex; flex-direction: column; align-items: center; gap: 12px; position: relative; margin-bottom: 16px;">
                @if (!string.IsNullOrEmpty(_imagePreviewUrl))
                {
                    <label for="upload-image" style="position: absolute; top: 10px; z-index: 2; opacity: 0.5; cursor: pointer;">
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" />
                    </label>

                    <img src="@_imagePreviewUrl"
                         alt="Preview"
                         style="max-height: 150px; max-width:150px; border-radius: 6px;" />
                }
                else
                {
                    <label for="upload-image" style="cursor: pointer;">
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" />
                    </label>
                }

                <InputFile id="upload-image"
                           OnChange="OnFileChanged"
                           accept="image/*"
                           style="display: none;" />
            </div>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Full Name"
                                  @bind-Value="_newUser.Fullname"
                                  Required="true"
                                  RequiredError="Full name is required"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Username"
                                  @bind-Value="_newUser.Username"
                                  Required="true"
                                  RequiredError="Username is required"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Email"
                                  @bind-Value="_newUser.Email"
                                  Required="true"
                                  RequiredError="Email is required"
                                  Validation="@(new Func<string, string?>(ValidateEmail))"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Position"
                                  @bind-Value="_newUser.Position"
                                  Required="true"
                                  RequiredError="Position is required"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Role"
                               Value="@_newUser.Role"
                               ValueChanged="@((string value) => { _newUser.Role = value; OnRoleChanged(value); })"
                               Required="true"
                               RequiredError="Role is required"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Council")">Council</MudSelectItem>
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="@(_newUser.Role == "Select" ? "Select Role" : _newUser.Role == "Admin" ? "Municipality" : "Barangay")"
                               @bind-Value="_newUser.Area"
                               Required="true"
                               RequiredError="@(_newUser.Role == "Select" ? "Area is required" : _newUser.Role == "Admin" ? "Municipality is required" : "Barangay is required")"
                               Variant="Variant.Outlined"
                               Disabled="@(_newUser.Role == "Select")">
                        @if (_newUser.Role == "Admin")
                        {
                            @foreach (var area in _municipalities)
                            {
                                <MudSelectItem Value="@area.Name">@area.Name</MudSelectItem>
                            }
                        }
                        else if (_newUser.Role == "Council")
                        {
                            @foreach (var area in _barangays)
                            {
                                <MudSelectItem Value="@area.Name">@area.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Password"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  @bind-Value="_newUser.Password"
                                  Required="true"
                                  RequiredError="Password is required"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Confirm Password"
                                  InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                  @bind-Value="_confirmPassword"
                                  Required="true"
                                  RequiredError="Confirm Password is required"
                                  Immediate="true"
                                  Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="ToggleConfirmPasswordVisibility"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="Submit" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Adding...</span>
            }
            else
            {
                <span>Add</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = default!;
    private bool _isSaving = false;

    private User _newUser = new() { Role = "Select" };
    private string _confirmPassword = string.Empty;
    private string? _imagePreviewUrl;

    private byte[]? _imageBytes;
    private string? _imageMimeType;

    private bool _showPassword = false;
    private bool _showConfirmPassword = false;

    private List<Area> _municipalities = new();
    private List<Area> _barangays = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _previousRole = "Select";

    private void OnRoleChanged(string newRole) // Removed async since no await
    {
        if (_previousRole != newRole)
        {
            _newUser.Area = string.Empty; // Clear the area field
            _previousRole = newRole;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAreas();
    }

    private async Task LoadAreas()
    {
        _municipalities = await Db.Areas.Where(a => a.Type == "Municipality").OrderBy(a => a.Name).ToListAsync();
        _barangays = await Db.Areas.Where(a => a.Type == "Barangay").OrderBy(a => a.Name).ToListAsync();
    }

    private string? ValidateConfirmPassword(string confirmPassword)
    {
        if (confirmPassword != _newUser.Password)
            return "Passwords do not match";
        return null;
    }

    private string? ValidateEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "Email is required";

        var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        if (!Regex.IsMatch(email, emailPattern, RegexOptions.IgnoreCase))
            return "Enter a valid email address (e.g., example@mail.com)";

        return null;
    }

    private static string HashPassword(string password)
    {
        using var sha256 = SHA256.Create();
        var bytes = Encoding.UTF8.GetBytes(password);
        var hash = sha256.ComputeHash(bytes);
        return Convert.ToBase64String(hash);
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (!_form.IsValid)
            return;

        _isSaving = true;

        try
        {
            // Check for existing username
            var existingUsername = Db.Users
                .FirstOrDefault(u => u.Username != null && u.Username.ToLower() == _newUser.Username.ToLower());

            if (existingUsername != null)
            {
                Snackbar.Add("Username already exists. Please choose a different username.", Severity.Warning);
                _isSaving = false;
                return;
            }

            // Check for existing email
            var existingEmail = Db.Users
                .FirstOrDefault(u => u.Email != null && u.Email.ToLower() == (_newUser.Email ?? "").ToLower());

            if (existingEmail != null)
            {
                Snackbar.Add("Email already exists. Please use a different email address.", Severity.Warning);
                _isSaving = false;
                return;
            }

            _newUser.Password = HashPassword(_newUser.Password);

            // Store image as binary data
            if (_imageBytes != null && !string.IsNullOrEmpty(_imageMimeType))
            {
                _newUser.ImageData = _imageBytes;
                _newUser.ImageMimeType = _imageMimeType;
            }

            Db.Users.Add(_newUser);
            await Db.SaveChangesAsync();

            Snackbar.Add("User added successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding user: {ex.Message}", Severity.Error);
            _isSaving = false;
        }
    }

    private async Task OnFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file.Size > 5 * 1024 * 1024)
        {
            Snackbar.Add("Image size must be less than 5MB", Severity.Warning);
            return;
        }

        try
        {
            using var inputStream = file.OpenReadStream(5 * 1024 * 1024);
            using var image = await Image.LoadAsync(inputStream);

            // Resize to 300x300 max
            image.Mutate(x => x.Resize(new SixLabors.ImageSharp.Processing.ResizeOptions
            {
                Size = new SixLabors.ImageSharp.Size(300, 300),
                Mode = SixLabors.ImageSharp.Processing.ResizeMode.Max
            }));

            using var ms = new MemoryStream();

            // Check if image has transparency (PNG)
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            bool isPng = extension == ".png";

            // Use PNG for transparent images, JPEG for others
            if (isPng)
            {
                var encoder = new PngEncoder { CompressionLevel = PngCompressionLevel.BestCompression };
                await image.SaveAsync(ms, encoder);
                _imageMimeType = "image/png";
                _imagePreviewUrl = $"data:image/png;base64,{Convert.ToBase64String(ms.ToArray())}";
            }
            else
            {
                var encoder = new JpegEncoder { Quality = 70 };
                await image.SaveAsync(ms, encoder);
                _imageMimeType = "image/jpeg";
                _imagePreviewUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
            }

            _imageBytes = ms.ToArray();

            Snackbar.Add($"Image uploaded ({_imageBytes.Length / 1024}KB)", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error processing image: {ex.Message}", Severity.Error);
        }
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;
    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;

    private void Cancel() => MudDialog.Cancel();
}