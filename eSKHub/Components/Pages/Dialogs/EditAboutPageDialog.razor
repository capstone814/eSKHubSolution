    private async Task Submit()
    {
        await _form.Validate();

        if (!_form.IsValid)
        {
            Snackbar.Add("Please fix validation errors before saving", Severity.Error);
            return;
        }

        _isSaving = true;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var contentData = new Dictionary<string, string>
            {
                { "WhoWeAreDescription", _whoWeAreDescription.Trim() },
                { "Mandate", _mandate.Trim() },
                { "LegalBasis", _legalBasis.Trim() },
                { "Vision", _vision.Trim() },
                { "Mission", _mission.Trim() },
                { "Goals", _goals.Trim() },
                { "CoreValues", _coreValues.Trim() },
                { "Timeline", JsonSerializer.Serialize(_timeline) },
                { "Leaders", JsonSerializer.Serialize(_leaders) },
                { "BarangayChapters", _barangayChapters.ToString() },
                { "TotalBarangays", "56" },
                { "CouncilUsers", _councilUsers.ToString() },
                { "YouthRegistered", _totalYouthCount.ToString() },
                { "Achievements", JsonSerializer.Serialize(_achievements) },
                { "RoleInLocalDevelopment", _roleInLocalDevelopment.Trim() },
                { "YouthDevelopmentFramework", _youthDevelopmentFramework.Trim() },
                { "ParticipationInGovernance", _participationInGovernance.Trim() }
            };

            var jsonContent = JsonSerializer.Serialize(contentData);

            if (Content == null)
            {
                var newContent = new PageContent
                {
                    PageName = "AboutPage",
                    Content = jsonContent,
                    DateModified = DateTime.Now,
                    ModifiedBy = UserState.Fullname
                };
                db.PageContents.Add(newContent);
            }
            else
            {
                var existingContent = await db.PageContents.FindAsync(Content.Id);
                if (existingContent != null)
                {
                    existingContent.Content = jsonContent;
                    existingContent.DateModified = DateTime.Now;
                    existingContent.ModifiedBy = UserState.Fullname;
                    db.PageContents.Update(existingContent);
                }
            }

            await db.SaveChangesAsync();
            Snackbar.Add("About page information saved successfully", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving content: {ex.Message}", Severity.Error);
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
