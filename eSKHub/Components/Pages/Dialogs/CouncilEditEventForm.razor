@using eSKHub.Components.Model
@using eSKHub.Model
@using eSKHub.Components.Services
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject AppDbContext Db
@inject UserStateService UserState

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Style="border-top: 5px solid #7e6fff; border-left: 3px solid #7e6fff; border-radius:4px;">
    <TitleContent>
        EDIT EVENT
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_editEvent">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Event Title"
                                  @bind-Value="_editEvent.Title"
                                  Required="true"
                                  RequiredError="Title is required"
                                  Variant="Variant.Outlined"
                                  MaxLength="200" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Description"
                                  @bind-Value="_editEvent.Description"
                                  Required="true"
                                  RequiredError="Description is required"
                                  Lines="4"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Event Date"
                                   @bind-Date="_eventDate"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   MinDate="DateTime.Today" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Event Type"
                               @bind-Value="_editEvent.EventType"
                               Required="true"
                               RequiredError="Event type is required"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Meeting")">Meeting</MudSelectItem>
                        <MudSelectItem Value="@("Sports")">Sports</MudSelectItem>
                        <MudSelectItem Value="@("Community")">Community</MudSelectItem>
                        <MudSelectItem Value="@("Workshop")">Workshop</MudSelectItem>
                        <MudSelectItem Value="@("Training")">Training</MudSelectItem>
                        <MudSelectItem Value="@("Cultural")">Cultural</MudSelectItem>
                        <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Start Time (Optional)"
                                   @bind-Time="_startTime"
                                   Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="End Time (Optional)"
                                   @bind-Time="_endTime"
                                   Variant="Variant.Outlined"
                                   MinTime="_startTime" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Location"
                                  @bind-Value="_editEvent.Location"
                                  Required="true"
                                  RequiredError="Location is required"
                                  Variant="Variant.Outlined"
                                  MaxLength="300" />
                </MudItem>

                <MudItem xs="12" sm="@(_editEvent.Audience == "Barangay" ? 6 : 12)">
                    <MudSelect T="string"
                               Label="Audience"
                               Value="@_editEvent.Audience"
                               ValueChanged="OnAudienceChanged"
                               Required="true"
                               RequiredError="Audience is required"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Public")">Public (Municipality-wide)</MudSelectItem>
                        <MudSelectItem Value="@("Barangay")">My Barangay Only</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (_editEvent.Audience == "Barangay")
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Target Barangay"
                                      Value="@_currentUserArea"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Disabled="true" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Additional Notes (Optional)"
                                  @bind-Value="_editEvent.Notes"
                                  Lines="3"
                                  Variant="Variant.Outlined" />
                </MudItem>

                @if (_editEvent.Audience == "Public" && !_editEvent.IsPublished)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true">
                            <strong>Note:</strong> This public event requires admin approval before it can be published.
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Updating...</span>
            }
            else
            {
                <span>Update Event</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = default!;
    private bool _isSaving = false;

    [Parameter] public Event EventToEdit { get; set; } = default!;

    private Event _editEvent = new();
    private DateTime? _eventDate;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private string _currentUserArea = string.Empty;
    private string _originalAudience = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await UserState.InitializeAsync();
        _currentUserArea = UserState.Area ?? "";

        _editEvent = new Event
        {
            Id = EventToEdit.Id,
            Title = EventToEdit.Title,
            Description = EventToEdit.Description,
            Location = EventToEdit.Location,
            EventType = EventToEdit.EventType,
            Organizer = EventToEdit.Organizer,
            OrganizerPosition = EventToEdit.OrganizerPosition,
            OrganizerArea = EventToEdit.OrganizerArea,
            Audience = EventToEdit.Audience,
            TargetBarangay = EventToEdit.TargetBarangay,
            Notes = EventToEdit.Notes,
            IsPublished = EventToEdit.IsPublished
        };

        _originalAudience = EventToEdit.Audience;
        _eventDate = EventToEdit.EventDate;
        _startTime = EventToEdit.StartTime;
        _endTime = EventToEdit.EndTime;
    }

    private void OnAudienceChanged(string newAudience)
    {
        _editEvent.Audience = newAudience;
        if (newAudience == "Barangay")
        {
            _editEvent.TargetBarangay = _currentUserArea;
        }
        else
        {
            _editEvent.TargetBarangay = null;
        }
        StateHasChanged();
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (!_form.IsValid || !_eventDate.HasValue)
        {
            Snackbar.Add("Please fill in all required fields", Severity.Warning);
            return;
        }

        _isSaving = true;

        try
        {
            using var db = await Db.Database.BeginTransactionAsync();
            var eventInDb = await Db.Events.FindAsync(_editEvent.Id);

            if (eventInDb != null)
            {
                eventInDb.Title = _editEvent.Title;
                eventInDb.Description = _editEvent.Description;
                eventInDb.EventDate = _eventDate.Value;
                eventInDb.StartTime = _startTime;
                eventInDb.EndTime = _endTime;
                eventInDb.Location = _editEvent.Location;
                eventInDb.EventType = _editEvent.EventType;
                eventInDb.Notes = _editEvent.Notes;
                eventInDb.DateModified = DateTime.Now;

                // Handle audience changes
                bool audienceChanged = _originalAudience != _editEvent.Audience;

                if (audienceChanged)
                {
                    eventInDb.Audience = _editEvent.Audience;
                    eventInDb.TargetBarangay = _editEvent.TargetBarangay;

                    if (_editEvent.Audience == "Public")
                    {
                        // Changed to Public - unpublish and needs admin approval
                        eventInDb.IsPublished = false;
                        Snackbar.Add("Event updated! Now awaiting admin approval for publishing.", Severity.Info);
                    }
                    else if (_editEvent.Audience == "Barangay")
                    {
                        // Changed to Barangay - can be published immediately
                        eventInDb.IsPublished = true;
                        Snackbar.Add("Event updated and published to your barangay!", Severity.Success);
                    }
                }
                else
                {
                    // Audience didn't change, just update other fields
                    // Keep existing publish status unless it's a public event that's not published
                    if (eventInDb.Audience == "Public" && !eventInDb.IsPublished)
                    {
                        // Still waiting for admin approval
                        Snackbar.Add("Event updated! Still awaiting admin approval.", Severity.Info);
                    }
                    else
                    {
                        Snackbar.Add("Event updated successfully!", Severity.Success);
                    }
                }

                await Db.SaveChangesAsync();
                await db.CommitAsync();
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating event: {ex.Message}", Severity.Error);
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}