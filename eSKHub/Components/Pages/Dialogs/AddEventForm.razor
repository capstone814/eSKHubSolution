@using eSKHub.Components.Model
@using eSKHub.Model
@using eSKHub.Components.Services
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject AppDbContext Db
@inject UserStateService UserState

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Style="border-top: 5px solid #7e6fff; border-left: 3px solid #7e6fff; border-radius:4px;">
    <TitleContent>
        CREATE EVENT
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_newEvent">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Event Title"
                                  @bind-Value="_newEvent.Title"
                                  Required="true"
                                  RequiredError="Title is required"
                                  Variant="Variant.Outlined"
                                  MaxLength="200" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Description"
                                  @bind-Value="_newEvent.Description"
                                  Required="true"
                                  RequiredError="Description is required"
                                  Lines="4"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Event Date"
                                   @bind-Date="_eventDate"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   MinDate="DateTime.Today" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Event Type"
                               @bind-Value="_newEvent.EventType"
                               Required="true"
                               RequiredError="Event type is required"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Meeting")">Meeting</MudSelectItem>
                        <MudSelectItem Value="@("Sports")">Sports</MudSelectItem>
                        <MudSelectItem Value="@("Community")">Community</MudSelectItem>
                        <MudSelectItem Value="@("Workshop")">Workshop</MudSelectItem>
                        <MudSelectItem Value="@("Training")">Training</MudSelectItem>
                        <MudSelectItem Value="@("Cultural")">Cultural</MudSelectItem>
                        <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Start Time (Optional)"
                                   @bind-Time="_startTime"
                                   Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="End Time (Optional)"
                                   @bind-Time="_endTime"
                                   Variant="Variant.Outlined"
                                   MinTime="_startTime" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Location"
                                  @bind-Value="_newEvent.Location"
                                  Required="true"
                                  RequiredError="Location is required"
                                  Variant="Variant.Outlined"
                                  MaxLength="300" />
                </MudItem>

                <MudItem xs="12" sm="@(_newEvent.Audience == "Barangay" ? 6 : 12)">
                    <MudSelect T="string"
                               Label="Audience"
                               Value="@_newEvent.Audience"
                               ValueChanged="OnAudienceChanged"
                               Required="true"
                               RequiredError="Audience is required"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Public")">Public (Municipality-wide)</MudSelectItem>
                        <MudSelectItem Value="@("Barangay")">Specific Barangay</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (_newEvent.Audience == "Barangay")
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string"
                                   Label="Select Barangay"
                                   @bind-Value="_newEvent.TargetBarangay"
                                   Required="true"
                                   RequiredError="Please select a barangay"
                                   Variant="Variant.Outlined">
                            @foreach (var barangay in _barangayList)
                            {
                                <MudSelectItem Value="@barangay">@barangay</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Additional Notes (Optional)"
                                  @bind-Value="_newEvent.Notes"
                                  Lines="3"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Creating...</span>
            }
            else
            {
                <span>Create Event</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = default!;
    private bool _isSaving = false;

    private Event _newEvent = new() { Audience = "Public", EventType = "Meeting" };
    private DateTime? _eventDate;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;

    private List<string> _barangayList = new();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await UserState.InitializeAsync();
        await LoadBarangayList();
    }

    private async Task LoadBarangayList()
    {
        try
        {
            // Load distinct barangay names from the database
            _barangayList = await Db.Users
                .Where(u => !string.IsNullOrEmpty(u.Area))
                .Select(u => u.Area!)
                .Distinct()
                .OrderBy(a => a)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading barangay list: {ex.Message}", Severity.Warning);
            _barangayList = new List<string>();
        }
    }

    private void OnAudienceChanged(string newAudience)
    {
        _newEvent.Audience = newAudience;
        if (newAudience != "Barangay")
        {
            _newEvent.TargetBarangay = null;
        }
        StateHasChanged();
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (!_form.IsValid || !_eventDate.HasValue)
        {
            Snackbar.Add("Please fill in all required fields", Severity.Warning);
            return;
        }

        if (_newEvent.Audience == "Barangay" && string.IsNullOrEmpty(_newEvent.TargetBarangay))
        {
            Snackbar.Add("Please select a barangay", Severity.Warning);
            return;
        }

        _isSaving = true;

        try
        {
            _newEvent.EventDate = _eventDate.Value;
            _newEvent.StartTime = _startTime;
            _newEvent.EndTime = _endTime;
            _newEvent.Organizer = UserState.Fullname ?? "Unknown";
            _newEvent.OrganizerPosition = UserState.Position ?? "";
            _newEvent.OrganizerArea = UserState.Area ?? "";
            _newEvent.DateCreated = DateTime.Now;

            Db.Events.Add(_newEvent);
            await Db.SaveChangesAsync();

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating event: {ex.Message}", Severity.Error);
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}