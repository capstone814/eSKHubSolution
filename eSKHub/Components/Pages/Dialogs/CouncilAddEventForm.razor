@using eSKHub.Components.Model
@using eSKHub.Model
@using eSKHub.Components.Services
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject AppDbContext Db
@inject UserStateService UserState

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true" Style="border-top: 5px solid #7e6fff; border-left: 3px solid #7e6fff; border-radius:4px;">
    <TitleContent>
        CREATE EVENT
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="_newEvent">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Event Title"
                                  @bind-Value="_newEvent.Title"
                                  Required="true"
                                  RequiredError="Title is required"
                                  Variant="Variant.Outlined"
                                  MaxLength="200" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Description"
                                  @bind-Value="_newEvent.Description"
                                  Required="true"
                                  RequiredError="Description is required"
                                  Lines="4"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Event Date"
                                   @bind-Date="_eventDate"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   MinDate="DateTime.Today" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Event Type"
                               @bind-Value="_newEvent.EventType"
                               Required="true"
                               RequiredError="Event type is required"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Meeting")">Meeting</MudSelectItem>
                        <MudSelectItem Value="@("Sports")">Sports</MudSelectItem>
                        <MudSelectItem Value="@("Community")">Community</MudSelectItem>
                        <MudSelectItem Value="@("Workshop")">Workshop</MudSelectItem>
                        <MudSelectItem Value="@("Training")">Training</MudSelectItem>
                        <MudSelectItem Value="@("Cultural")">Cultural</MudSelectItem>
                        <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Start Time (Optional)"
                                   @bind-Time="_startTime"
                                   Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="End Time (Optional)"
                                   @bind-Time="_endTime"
                                   Variant="Variant.Outlined"
                                   MinTime="_startTime" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Location"
                                  @bind-Value="_newEvent.Location"
                                  Required="true"
                                  RequiredError="Location is required"
                                  Variant="Variant.Outlined"
                                  MaxLength="300" />
                </MudItem>

                <MudItem xs="12" sm="@(_newEvent.Audience == "Barangay" ? 6 : 12)">
                    <MudSelect T="string"
                               Label="Audience"
                               Value="@_newEvent.Audience"
                               ValueChanged="OnAudienceChanged"
                               Required="true"
                               RequiredError="Audience is required"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Public")">Public (Municipality-wide)</MudSelectItem>
                        <MudSelectItem Value="@("Barangay")">My Barangay Only</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @if (_newEvent.Audience == "Barangay")
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Target Barangay"
                                      Value="@_currentUserArea"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Disabled="true" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Additional Notes (Optional)"
                                  @bind-Value="_newEvent.Notes"
                                  Lines="3"
                                  Variant="Variant.Outlined" />
                </MudItem>

                @if (_newEvent.Audience == "Public")
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true">
                            <strong>Note:</strong> Public events require admin approval before they can be published.
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Creating...</span>
            }
            else
            {
                <span>Create Event</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = default!;
    private bool _isSaving = false;

    private Event _newEvent = new() { Audience = "Barangay", EventType = "Meeting" };
    private DateTime? _eventDate;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private string _currentUserArea = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await UserState.InitializeAsync();
        _currentUserArea = UserState.Area ?? "";
        _newEvent.TargetBarangay = _currentUserArea;
    }

    private void OnAudienceChanged(string newAudience)
    {
        _newEvent.Audience = newAudience;
        if (newAudience == "Barangay")
        {
            _newEvent.TargetBarangay = _currentUserArea;
        }
        else
        {
            _newEvent.TargetBarangay = null;
        }
        StateHasChanged();
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (!_form.IsValid || !_eventDate.HasValue)
        {
            Snackbar.Add("Please fill in all required fields", Severity.Warning);
            return;
        }

        _isSaving = true;

        try
        {
            _newEvent.EventDate = _eventDate.Value;
            _newEvent.StartTime = _startTime;
            _newEvent.EndTime = _endTime;
            _newEvent.Organizer = UserState.Fullname ?? "Unknown";
            _newEvent.OrganizerPosition = UserState.Position ?? "";
            _newEvent.OrganizerArea = UserState.Area ?? "";
            _newEvent.DateCreated = DateTime.Now;

            // Set IsPublished based on audience
            // Barangay events can be published immediately, Public events need admin approval
            _newEvent.IsPublished = _newEvent.Audience == "Barangay";

            Db.Events.Add(_newEvent);
            await Db.SaveChangesAsync();

            if (_newEvent.Audience == "Public")
            {
                Snackbar.Add("Event created! Awaiting admin approval for publishing.", Severity.Info);
            }
            else
            {
                Snackbar.Add("Event created and published to your barangay!", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating event: {ex.Message}", Severity.Error);
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}