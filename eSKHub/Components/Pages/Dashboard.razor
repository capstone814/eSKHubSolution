                    Create Event
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Assessment"
                           FullWidth="true"
                           Class="quick-action-btn"
                           Href="/transparency-manage">
                    Upload Report
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
