@page "/transparency-manage"
@layout eSKHub.Components.Layout.MainLayout
@using Microsoft.EntityFrameworkCore
@using eSKHub.Components.Model
@using eSKHub.Components.Services
@using eSKHub.Components.Pages.Dialogs
@using eSKHub.Components.Dialogs
@inject IDialogService DialogService
@inject UserStateService UserState
@inject IDbContextFactory<eSKHub.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>Manage Transparency Documents</PageTitle>

<style>
    .document-card {
        margin-bottom: 16px;
        border-left: 4px solid #7e6fff;
        transition: transform 0.2s ease;
    }

        .document-card:hover {
            transform: translateX(4px);
        }

    .document-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        background: linear-gradient(135deg, rgba(126, 111, 255, 0.1) 0%, rgba(126, 111, 255, 0.05) 100%);
    }

    .document-body {
        padding: 16px;
    }

    .document-meta {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    .add-document-btn {
        margin-bottom: 16px;
        margin-top: 16px;
    }

    .filter-section {
        margin-bottom: 16px;
    }

    .filter-toggle-button {
        display: none;
        margin-bottom: 8px;
    }

    .desktop-cards {
        display: block;
    }

    .mobile-cards {
        display: none;
    }

    @@media (max-width: 600px) {
        .document-meta {
            font-size: 0.85rem;
        }

        .add-document-btn {
            width: 100%;
            margin-bottom: 12px;
        }

        .filter-toggle-button {
            display: inline-flex !important;
            width: 100%;
        }

        .filter-section .mud-grid {
            display: none;
        }

        .filter-section.filters-visible .mud-grid {
            display: flex;
        }

        .desktop-cards {
            display: none;
        }

        .mobile-cards {
            display: block;
        }

        .document-mobile-card {
            margin-bottom: 12px;
            border-left: 4px solid #7e6fff;
        }

        .document-mobile-header {
            background-color: #7e6fff;
            color: white;
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top-right-radius: 4px;
        }

        .document-mobile-content {
            padding: 16px;
        }

        .document-mobile-actions {
            border-top: 1px solid rgba(0, 0, 0, 0.12);
            display: flex;
            gap: 8px;
            flex-wrap: nowrap;
            justify-content: space-between;
            padding: 10px 16px;
        }

            .document-mobile-actions .mud-icon-button {
                flex: 1;
                min-width: 0;
            }

        .document-field-label {
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--mud-palette-text-secondary);
            margin-bottom: 4px;
        }

        .document-field-value {
            font-size: 0.9rem;
            margin-bottom: 12px;
        }
    }
</style>

<MudButton Class="add-document-btn"
           Variant="Variant.Filled"
           StartIcon="@Icons.Material.Filled.Add"
           Color="Color.Info"
           Size="Size.Small"
           OnClick="OpenAddDialog">
    TRANSPARENCY DOCUMENT
</MudButton>

<!-- Filter Section -->
<MudPaper Class="@($"filter-section pa-4 {(_showFilters ? "filters-visible" : "")}")" Elevation="1">
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
               FullWidth="true"
               OnClick="@(() => _showFilters = !_showFilters)"
               Class="filter-toggle-button">
        @(_showFilters ? "Hide Filters" : "Show Filters")
    </MudButton>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="6">
            <MudTextField T="string"
                          @bind-Value="_searchTerm"
                          @bind-Value:after="ApplyFilters"
                          Label="Search Documents"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Placeholder="Title, description..."
                          Immediate="true"
                          DebounceInterval="300"
                          Dense="true"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string"
                       @bind-Value="_categoryFilter"
                       @bind-Value:after="ApplyFilters"
                       Label="Category"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("All")">All Categories</MudSelectItem>
                <MudSelectItem Value="@("Budget")">Budget</MudSelectItem>
                <MudSelectItem Value="@("Resolution")">Resolution</MudSelectItem>
                <MudSelectItem Value="@("Performance")">Performance</MudSelectItem>
                <MudSelectItem Value="@("Procurement")">Procurement</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string"
                       @bind-Value="_statusFilter"
                       @bind-Value:after="ApplyFilters"
                       Label="Status"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("All")">All Status</MudSelectItem>
                <MudSelectItem Value="@("Published")">Published</MudSelectItem>
                <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="int?"
                       @bind-Value="_fiscalYearFilter"
                       @bind-Value:after="ApplyFilters"
                       Label="Fiscal Year"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Clearable="true">
                @foreach (var year in _availableYears)
                {
                    <MudSelectItem T="int?" Value="@((int?)year)">@year</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Showing @_pagedDocuments.Count of @_filteredDocuments.Count documents
                </MudText>
                @if (HasActiveFilters())
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ClearFilters">
                        Clear Filters
                    </MudButton>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="0" Class="pa-4">
    @if (_pagedDocuments == null || !_pagedDocuments.Any())
    {
        <MudAlert Severity="Severity.Info">
            @if (HasActiveFilters())
            {
                <text>No documents found matching your filters.</text>
            }
            else
            {
                <text>No transparency documents yet. Create your first document!</text>
            }
        </MudAlert>
    }
    else
    {
        <!-- Desktop View -->
        <div class="desktop-cards">
            @foreach (var doc in _pagedDocuments)
            {
                <MudCard Class="document-card" Elevation="2">
                    <div class="document-header">
                        <div>
                            <MudText Typo="Typo.h6" Style="font-weight: 600;">@doc.Title</MudText>
                            <div class="document-meta">
                                <MudChip T="string" Size="Size.Small" Color="@(doc.IsPublished? Color.Success: Color.Default)">
                                    @(doc.IsPublished ? "Published" : "Draft")
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@GetCategoryColor(doc.Category)">
                                    @doc.Category
                                </MudChip>
                                @if (doc.FiscalYear.HasValue)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                                        FY @doc.FiscalYear
                                    </MudChip>
                                }
                                @if (!string.IsNullOrEmpty(doc.Quarter))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                                        @doc.Quarter
                                    </MudChip>
                                }
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.RemoveRedEye">
                                    @doc.ViewCount views
                                </MudChip>
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="display: flex; align-items: center; gap: 6px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                    @doc.UploadedBy
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="display: flex; align-items: center; gap: 6px;">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                                    @doc.DateUploaded.ToString("MMM dd, yyyy")
                                </MudText>
                            </div>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => ViewDocument(doc))"
                                           Title="View" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => EditDocument(doc))"
                                           Title="Edit" />
                            <MudIconButton Icon="@(doc.IsPublished? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Publish)"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           OnClick="@(() => TogglePublish(doc))"
                                           Title="@(doc.IsPublished ? "Unpublish" : "Publish")" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteDocument(doc))"
                                           Title="Delete" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(doc.Description))
                    {
                        <div class="document-body">
                            <MudText Typo="Typo.body2" Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @doc.Description
                            </MudText>
                        </div>
                    }
                    @if (doc.FileData != null && doc.FileData.Length > 0)
                    {
                        <MudCardActions>
                            <MudChip T="string" Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Color="Color.Secondary">
                                @(doc.FileName ?? "Document attached") (@FormatFileSize(doc.FileData.Length))
                            </MudChip>
                        </MudCardActions>
                    }
                </MudCard>
            }
        </div>

        <!-- Mobile View -->
        <div class="mobile-cards">
            @for (int i = 0; i < _pagedDocuments.Count; i++)
            {
                var doc = _pagedDocuments[i];
                var index = (_currentPage - 1) * _pageSize + i + 1;

                <MudCard Class="document-mobile-card" Elevation="2">
                    <div class="document-mobile-header">
                        <span><strong>Document #@index</strong></span>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(doc.IsPublished ? Color.Success : Color.Default)"
                                 Style="background: rgba(255,255,255,0.3); color: white;">
                            @(doc.IsPublished ? "Published" : "Draft")
                        </MudChip>
                    </div>
                    <div class="document-mobile-content">
                        <MudText Typo="Typo.body2" Class="document-field-label">
                            <strong>Title:</strong>
                        </MudText>
                        <MudText Typo="Typo.body1" Class="document-field-value">
                            @doc.Title
                        </MudText>

                        <MudText Typo="Typo.body2" Class="document-field-label">
                            <strong>Category:</strong>
                        </MudText>
                        <MudText Typo="Typo.body1" Class="document-field-value">
                            <MudChip T="string" Size="Size.Small" Color="@GetCategoryColor(doc.Category)">
                                @doc.Category
                            </MudChip>
                        </MudText>

                        @if (doc.FiscalYear.HasValue)
                        {
                            <MudText Typo="Typo.body2" Class="document-field-label">
                                <strong>Fiscal Year:</strong>
                            </MudText>
                            <MudText Typo="Typo.body1" Class="document-field-value">
                                FY @doc.FiscalYear
                            </MudText>
                        }

                        @if (!string.IsNullOrEmpty(doc.Quarter))
                        {
                            <MudText Typo="Typo.body2" Class="document-field-label">
                                <strong>Quarter:</strong>
                            </MudText>
                            <MudText Typo="Typo.body1" Class="document-field-value">
                                @doc.Quarter
                            </MudText>
                        }

                        <MudText Typo="Typo.body2" Class="document-field-label">
                            <strong>Uploaded By:</strong>
                        </MudText>
                        <MudText Typo="Typo.body1" Class="document-field-value">
                            @doc.UploadedBy
                        </MudText>

                        <MudText Typo="Typo.body2" Class="document-field-label">
                            <strong>Date Uploaded:</strong>
                        </MudText>
                        <MudText Typo="Typo.body1" Class="document-field-value">
                            @doc.DateUploaded.ToString("MMM dd, yyyy")
                        </MudText>

                        <MudText Typo="Typo.body2" Class="document-field-label">
                            <strong>Views:</strong>
                        </MudText>
                        <MudText Typo="Typo.body1" Class="document-field-value">
                            @doc.ViewCount
                        </MudText>

                        @if (!string.IsNullOrEmpty(doc.Description))
                        {
                            <MudText Typo="Typo.body2" Class="document-field-label">
                                <strong>Description:</strong>
                            </MudText>
                            <MudText Typo="Typo.body2" Class="document-field-value">
                                @doc.Description
                            </MudText>
                        }
                    </div>
                    <div class="document-mobile-actions">
                        <MudIconButton Variant="Variant.Filled"
                                       Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="@(() => ViewDocument(doc))" />
                        <MudIconButton Variant="Variant.Filled"
                                       Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditDocument(doc))" />
                        <MudIconButton Variant="Variant.Filled"
                                       Icon="@(doc.IsPublished ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Publish)"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => TogglePublish(doc))" />
                        <MudIconButton Variant="Variant.Filled"
                                       Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteDocument(doc))" />
                    </div>
                </MudCard>
            }
        </div>

        <!-- Pagination -->
        <div style="display: flex; justify-content: center; margin-top: 24px;">
            <MudPagination Count="@_totalPages"
                           Selected="@_currentPage"
                           SelectedChanged="OnPageChanged"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           ShowFirstButton="true"
                           ShowLastButton="true" />
        </div>
    }
</MudPaper>

@code {
    private bool _showFilters = false;
    private List<TransparencyDocument> _allDocuments = new();
    private List<TransparencyDocument> _filteredDocuments = new();
    private List<TransparencyDocument> _pagedDocuments = new();
    private List<int> _availableYears = new();
    private bool _initialized = false;

    private string _searchTerm = string.Empty;
    private string _categoryFilter = "All";
    private string _statusFilter = "All";
    private int? _fiscalYearFilter = null;

    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await UserState.InitializeAsync();
            await LoadDocuments();
        }
    }

    private async Task LoadDocuments()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        _allDocuments = await db.TransparencyDocuments
            .OrderByDescending(d => d.DateUploaded)
            .AsNoTracking()
            .ToListAsync();

        _availableYears = _allDocuments
            .Where(d => d.FiscalYear.HasValue)
            .Select(d => d.FiscalYear!.Value)
            .Distinct()
            .OrderByDescending(y => y)
            .ToList();

        ApplyFilters();
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        _filteredDocuments = _allDocuments;

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredDocuments = _filteredDocuments.Where(d =>
                (d.Title?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (d.Description?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        if (_categoryFilter != "All")
        {
            _filteredDocuments = _filteredDocuments.Where(d => d.Category == _categoryFilter).ToList();
        }

        if (_statusFilter != "All")
        {
            bool isPublished = _statusFilter == "Published";
            _filteredDocuments = _filteredDocuments.Where(d => d.IsPublished == isPublished).ToList();
        }

        if (_fiscalYearFilter.HasValue)
        {
            _filteredDocuments = _filteredDocuments.Where(d => d.FiscalYear == _fiscalYearFilter.Value).ToList();
        }

        _currentPage = 1;
        UpdatePagination();
    }

    private void UpdatePagination()
    {
        _totalPages = (int)Math.Ceiling(_filteredDocuments.Count / (double)_pageSize);
        if (_totalPages == 0) _totalPages = 1;

        var skip = (_currentPage - 1) * _pageSize;
        _pagedDocuments = _filteredDocuments.Skip(skip).Take(_pageSize).ToList();
        StateHasChanged();
    }

    private void OnPageChanged(int page)
    {
        _currentPage = page;
        UpdatePagination();
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _categoryFilter = "All";
        _statusFilter = "All";
        _fiscalYearFilter = null;
        ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(_searchTerm) ||
               _categoryFilter != "All" ||
               _statusFilter != "All" ||
               _fiscalYearFilter.HasValue;
    }

    private Color GetCategoryColor(string category) => category switch
    {
        "Budget" => Color.Success,
        "Resolution" => Color.Primary,
        "Performance" => Color.Info,
        "Procurement" => Color.Warning,
        _ => Color.Default
    };

    private string FormatFileSize(int bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddTransparencyDocumentDialog>("Add Transparency Document", options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            await LoadDocuments();
            Snackbar.Add("Document added successfully!", Severity.Success);
        }
    }

    private async Task ViewDocument(TransparencyDocument doc)
    {
        var parameters = new DialogParameters { { "Document", doc } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<ViewTransparencyDocumentDialog>("Document Details", parameters, options);
    }

    private async Task EditDocument(TransparencyDocument doc)
    {
        var parameters = new DialogParameters { { "DocumentToEdit", doc } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditTransparencyDocumentDialog>("Edit Document", parameters, options);
        var result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            await LoadDocuments();
            Snackbar.Add("Document updated successfully!", Severity.Success);
        }
    }

    private async Task TogglePublish(TransparencyDocument doc)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var docInDb = await db.TransparencyDocuments.FindAsync(doc.Id);

        if (docInDb != null)
        {
            docInDb.IsPublished = !docInDb.IsPublished;
            docInDb.DateModified = DateTime.Now;
            await db.SaveChangesAsync();

            await LoadDocuments();
            Snackbar.Add(docInDb.IsPublished ? "Document published!" : "Document unpublished!", Severity.Info);
        }
    }

    private async Task DeleteDocument(TransparencyDocument doc)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Are you sure you want to delete '{doc.Title}'? This action cannot be undone." },
            { "ButtonText", "Delete" },
            { "Color", Color.Error }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialogRef = await DialogService.ShowAsync<ConfirmDialog>("Confirm Delete", parameters, options);
        var result = await dialogRef.Result;

        if (!(result?.Canceled ?? true))
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var docToDelete = await db.TransparencyDocuments.FindAsync(doc.Id);

            if (docToDelete != null)
            {
                db.TransparencyDocuments.Remove(docToDelete);
                await db.SaveChangesAsync();
            }

            await LoadDocuments();
            Snackbar.Add("Document deleted successfully!", Severity.Success);
        }
    }
}