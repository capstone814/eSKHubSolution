@page "/council/feedbacks-manage"
@layout eSKHub.Components.Layout.CouncilLayout
@using Microsoft.EntityFrameworkCore
@using eSKHub.Components.Model
@using eSKHub.Components.Services
@using eSKHub.Components.Dialogs
@using eSKHub.Components.Pages.Dialogs
@inject IDialogService DialogService
@inject UserStateService UserState
@inject IDbContextFactory<eSKHub.Model.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Feedback Management</PageTitle>

<style>
    .feedback-card {
        margin-bottom: 16px;
        transition: all 0.3s ease;
    }

        .feedback-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(126, 111, 255, 0.25);
        }

    .feedback-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .feedback-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-right: 8px;
    }

    .badge-unread {
        background: #ef4444;
        color: white;
    }

    .badge-read {
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }

    .badge-forwarded {
        background: #f59e0b;
        color: white;
    }

    .feedback-content {
        padding: 20px;
    }

    .feedback-field {
        margin-bottom: 16px;
    }

    .feedback-label {
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .feedback-value {
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .feedback-message {
        background: rgba(126, 111, 255, 0.05);
        padding: 16px;
        border-radius: 8px;
        border-left: 4px solid #667eea;
    }

    .feedback-actions {
        padding: 12px 20px;
        border-top: 1px solid var(--mud-palette-divider);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .category-chip {
        font-size: 0.75rem;
        padding: 4px 12px;
        border-radius: 12px;
        font-weight: 600;
    }

    .filter-section {
        margin-bottom: 16px;
    }

    .filter-toggle-button {
        display: none;
        margin-bottom: 8px;
    }

    .stats-overview {
        margin-bottom: 24px;
        margin-top: -8px;
    }

    .stat-card {
        text-align: center;
        padding: 20px;
        border-radius: 12px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 0.875rem;
        opacity: 0.9;
    }

    @@media (max-width: 600px) {
        .feedback-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }

        .feedback-actions {
            flex-direction: column;
            gap: 8px;
            align-items: stretch;
        }

            .feedback-actions > .mud-typography {
                width: 100%;
                text-align: center;
                margin-bottom: 8px;
            }

            .feedback-actions > div {
                width: 100%;
                display: flex;
                gap: 8px;
                flex-wrap: nowrap;
                justify-content: space-between;
            }

                .feedback-actions > div .mud-button-root {
                    flex: 1;
                    min-width: 0;
                    font-size: 0.5rem;
                }

        .filter-toggle-button {
            display: inline-flex !important;
            width: 100%;
        }

        .filter-section .mud-grid {
            display: none;
        }

        .filter-section.filters-visible .mud-grid {
            display: flex;
        }
    }
</style>

@if (!_isAuthorized)
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">
        <MudText>You are not authorized to view this page.</MudText>
    </MudAlert>
}
else if (_isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; min-height: 400px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{

    <!-- Statistics Overview -->
    <MudGrid Class="stats-overview">
        <MudItem xs="6" sm="3">
            <MudPaper Class="stat-card" Elevation="2">
                <div class="stat-number">@_totalFeedbacks</div>
                <div class="stat-label">Total Feedbacks</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="stat-card" Elevation="2" Style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
                <div class="stat-number">@_unreadFeedbacks</div>
                <div class="stat-label">Unread</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="stat-card" Elevation="2" Style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <div class="stat-number">@_readFeedbacks</div>
                <div class="stat-label">Read</div>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="stat-card" Elevation="2" Style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                <div class="stat-number">@_todayFeedbacks</div>
                <div class="stat-label">Today</div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Filter Section -->
    <MudPaper Class="@($"filter-section pa-4 {(_showFilters ? "filters-visible" : "")}")" Elevation="1">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@(_showFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.FilterAlt)"
                   FullWidth="true"
                   OnClick="@(() => _showFilters = !_showFilters)"
                   Class="filter-toggle-button">
            @(_showFilters ? "Hide Filters" : "Show Filters")
        </MudButton>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="6">
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              @bind-Value:after="ApplyFilters"
                              Label="Search Feedbacks"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Placeholder="Name, email, subject..."
                              Immediate="true"
                              DebounceInterval="300"
                              Dense="true"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           @bind-Value="_categoryFilter"
                           @bind-Value:after="ApplyFilters"
                           Label="Category"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="@("All")">All Categories</MudSelectItem>
                    <MudSelectItem Value="@("General")">General</MudSelectItem>
                    <MudSelectItem Value="@("Suggestion")">Suggestion</MudSelectItem>
                    <MudSelectItem Value="@("Complaint")">Complaint</MudSelectItem>
                    <MudSelectItem Value="@("Inquiry")">Inquiry</MudSelectItem>
                    <MudSelectItem Value="@("Appreciation")">Appreciation</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           @bind-Value="_statusFilter"
                           @bind-Value:after="ApplyFilters"
                           Label="Status"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Margin="Margin.Dense">
                    <MudSelectItem Value="@("All")">All Status</MudSelectItem>
                    <MudSelectItem Value="@("Unread")">Unread</MudSelectItem>
                    <MudSelectItem Value="@("Read")">Read</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Showing @(_pagedFeedbacks?.Count ?? 0) of @(_filteredFeedbacks?.Count ?? 0) feedbacks
                    </MudText>
                    @if (HasActiveFilters())
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="ClearFilters">
                            Clear Filters
                        </MudButton>
                    }
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Feedbacks List -->
    <MudPaper Elevation="0" Class="pa-4">
        @if (_pagedFeedbacks == null || !_pagedFeedbacks.Any())
        {
            <MudAlert Severity="Severity.Info">
                @if (HasActiveFilters())
                {
                    <text>No feedbacks found matching your filters.</text>
                }
                else
                {
                    <text>No feedbacks have been submitted yet from your barangay youth.</text>
                }
            </MudAlert>
        }
        else
        {
            @foreach (var feedback in _pagedFeedbacks)
            {
                <MudCard Class="feedback-card" Elevation="2">
                    <div class="feedback-header">
                        <div>
                            <span class="feedback-badge @(feedback.IsReadByUser(UserState.Username ?? "") ? "badge-read" : "badge-unread")">
                                @(feedback.IsReadByUser(UserState.Username ?? "") ? "Read" : "New")
                            </span>
                            @if (feedback.IsForwarded && IsForwardedToThisBarangay(feedback))
                            {
                                <span class="feedback-badge badge-forwarded">
                                    Forwarded to you by admin
                                </span>
                            }
                            <MudChip T="string" Size="Size.Small" Style="@GetCategoryStyle(feedback.Category)">
                                @feedback.Category
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.caption" Style="opacity: 0.9;">
                            @GetTimeAgo(feedback.DateSubmitted)
                        </MudText>
                    </div>

                    <div class="feedback-content">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <div class="feedback-field">
                                    <div class="feedback-label">Name</div>
                                    <div class="feedback-value">@feedback.Name</div>
                                </div>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <div class="feedback-field">
                                    <div class="feedback-label">Email</div>
                                    <div class="feedback-value">@feedback.Email</div>
                                </div>
                            </MudItem>
                            @if (!string.IsNullOrEmpty(feedback.ContactNumber))
                            {
                                <MudItem xs="12" sm="6">
                                    <div class="feedback-field">
                                        <div class="feedback-label">Contact Number</div>
                                        <div class="feedback-value">@feedback.ContactNumber</div>
                                    </div>
                                </MudItem>
                            }
                            <MudItem xs="12" sm="@(string.IsNullOrEmpty(feedback.ContactNumber) ? 12 : 6)">
                                <div class="feedback-field">
                                    <div class="feedback-label">Subject</div>
                                    <div class="feedback-value" style="font-weight: 600;">@feedback.Subject</div>
                                </div>
                            </MudItem>
                            <MudItem xs="12">
                                <div class="feedback-field">
                                    <div class="feedback-label">Message</div>
                                    <div class="feedback-message">
                                        <div class="feedback-value">@feedback.Message</div>
                                    </div>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="feedback-actions">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Submitted: @feedback.DateSubmitted.ToString("MMM dd, yyyy hh:mm tt")
                        </MudText>
                        <div style="display: flex; gap: 8px;">
                            @if (feedback.IsForwarded && IsForwardedToThisBarangay(feedback))
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.CheckCircleOutline"
                                           OnClick="@(() => MarkForwardedAsSolved(feedback))">
                                    Solved
                                </MudButton>
                            }
                            @if (!feedback.IsReadByUser(UserState.Username ?? ""))
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.CheckCircle"
                                           OnClick="@(() => MarkAsRead(feedback))">
                                    Read
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.RadioButtonUnchecked"
                                           OnClick="@(() => MarkAsUnread(feedback))">
                                    Unread
                                </MudButton>
                            }
                        </div>
                    </div>
                </MudCard>
            }

            <!-- Pagination -->
            <div style="display: flex; justify-content: center; margin-top: 24px;">
                <MudPagination Count="@_totalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </div>
        }
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthorized = false;
    private bool _showFilters = false;
    private bool _initialized = false;

    private string _councilBarangay = string.Empty;
    //private int _councilId;

    private List<Feedback> _allFeedbacks = new();
    private List<Feedback> _filteredFeedbacks = new();
    private List<Feedback> _pagedFeedbacks = new();

    private string _searchTerm = string.Empty;
    private string _categoryFilter = "All";
    private string _statusFilter = "All";

    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    private int _totalFeedbacks = 0;
    private int _unreadFeedbacks = 0;
    private int _readFeedbacks = 0;
    private int _todayFeedbacks = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await UserState.InitializeAsync();
            await InitializeCouncilData();
        }
    }

    private async Task InitializeCouncilData()
    {
        if (!UserState.IsAuthenticated || string.IsNullOrEmpty(UserState.Username))
        {
            _isAuthorized = false;
            _isLoading = false;
            StateHasChanged();
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var councilUser = await db.Users.FirstOrDefaultAsync(u => u.Username == UserState.Username);

            if (councilUser == null || councilUser.Role != "Council")
            {
                _isAuthorized = false;
                Snackbar.Add("Access denied. Council members only.", Severity.Error);
                _isLoading = false;
                StateHasChanged();
                return;
            }

            _councilBarangay = councilUser.Area ?? string.Empty;

            if (string.IsNullOrEmpty(_councilBarangay))
            {
                _isAuthorized = false;
                Snackbar.Add("No barangay assigned to your account.", Severity.Warning);
                _isLoading = false;
                StateHasChanged();
                return;
            }

            _isAuthorized = true;

            var youthEmails = await db.Youths
                .Where(y => y.Barangay == _councilBarangay)
                .Select(y => y.Email)
                .ToListAsync();

            _allFeedbacks = await db.Feedbacks
                .Where(f => youthEmails.Contains(f.Email) ||
                           (f.IsForwarded && f.ForwardedToBarangays != null &&
                            f.ForwardedToBarangays.Contains(_councilBarangay)))
                .OrderByDescending(f => f.DateSubmitted)
                .AsNoTracking()
                .ToListAsync();

            // Filter out feedbacks that are solved for this barangay
            _allFeedbacks = _allFeedbacks
                .Where(f => !f.IsSolvedForBarangay(_councilBarangay))
                .ToList();

            _totalFeedbacks = _allFeedbacks.Count;
            _unreadFeedbacks = _allFeedbacks.Count(f => !f.IsReadByUser(UserState.Username ?? ""));
            _readFeedbacks = _allFeedbacks.Count(f => f.IsReadByUser(UserState.Username ?? ""));
            _todayFeedbacks = _allFeedbacks.Count(f => f.DateSubmitted.Date == DateTime.Today);

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
            _isAuthorized = false;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task MarkForwardedAsSolved(Feedback feedback)
    {
        var parameters = new DialogParameters
    {
        { "ContentText", "Are you sure you want to mark this forwarded feedback as solved? This will remove it from your feedback list." },
        { "ButtonText", "Yes, Mark as Solved" },
        { "Color", Color.Primary }
    };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Action", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var feedbackInDb = await db.Feedbacks.FindAsync(feedback.Id);

            if (feedbackInDb != null)
            {
                feedbackInDb.MarkAsSolvedForBarangay(_councilBarangay);
                await db.SaveChangesAsync();

                Snackbar.Add("Forwarded feedback marked as solved and removed from your list", Severity.Success);
                await LoadData();
            }
        }
    }

    private void ApplyFilters()
    {
        _filteredFeedbacks = _allFeedbacks;

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredFeedbacks = _filteredFeedbacks.Where(f =>
                (f.Name?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (f.Email?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (f.Subject?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (f.Message?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        if (_categoryFilter != "All")
        {
            _filteredFeedbacks = _filteredFeedbacks.Where(f => f.Category == _categoryFilter).ToList();
        }

        if (_statusFilter != "All")
        {
            bool isRead = _statusFilter == "Read";
            _filteredFeedbacks = _filteredFeedbacks.Where(f => f.IsRead == isRead).ToList();
        }

        _currentPage = 1;
        UpdatePagination();
    }

    private void UpdatePagination()
    {
        _totalPages = (int)Math.Ceiling(_filteredFeedbacks.Count / (double)_pageSize);
        if (_totalPages == 0) _totalPages = 1;

        var skip = (_currentPage - 1) * _pageSize;
        _pagedFeedbacks = _filteredFeedbacks
            .Skip(skip)
            .Take(_pageSize)
            .ToList();

        StateHasChanged();
    }

    private void OnPageChanged(int page)
    {
        _currentPage = page;
        UpdatePagination();
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _categoryFilter = "All";
        _statusFilter = "All";
        ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(_searchTerm) ||
               _categoryFilter != "All" ||
               _statusFilter != "All";
    }

    private string GetCategoryStyle(string category) => category switch
    {
        "Suggestion" => "background: rgba(16, 185, 129, 1); color: #ffffff;",
        "Complaint" => "background: rgba(239, 68, 68, 1); color: #ffffff;",
        "Inquiry" => "background: rgba(59, 130, 246, 1); color: #ffffff;",
        "Appreciation" => "background: rgba(245, 158, 11, 1); color: #ffffff;",
        _ => "background: rgba(107, 114, 128, 1); color: #ffffff;"
    };

    private string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;

        if (timeSpan.TotalMinutes < 1) return "Just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays}d ago";

        return dateTime.ToString("MMM dd, yyyy");
    }

    private async Task MarkAsRead(Feedback feedback)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var feedbackInDb = await db.Feedbacks.FindAsync(feedback.Id);

        if (feedbackInDb != null && !string.IsNullOrEmpty(UserState.Username))
        {
            feedbackInDb.MarkAsReadByUser(UserState.Username);
            feedbackInDb.DateRead = DateTime.Now;
            await db.SaveChangesAsync();

            Snackbar.Add("Feedback marked as read", Severity.Success);
            await LoadData();
        }
    }

    private async Task MarkAsUnread(Feedback feedback)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var feedbackInDb = await db.Feedbacks.FindAsync(feedback.Id);

        if (feedbackInDb != null && !string.IsNullOrEmpty(UserState.Username))
        {
            feedbackInDb.MarkAsUnreadByUser(UserState.Username);
            await db.SaveChangesAsync();

            Snackbar.Add("Feedback marked as unread", Severity.Success);
            await LoadData();
        }
    }
    private bool IsForwardedToThisBarangay(Feedback feedback)
    {
        if (string.IsNullOrEmpty(feedback.ForwardedToBarangays) || string.IsNullOrEmpty(_councilBarangay))
            return false;

        var forwardedBarangays = feedback.GetForwardedBarangays();
        return forwardedBarangays.Contains(_councilBarangay);
    }
}