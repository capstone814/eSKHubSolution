@code {
    private bool _showFilters = false;

    // Filter values
    private string _periodFilter = "Month";
    private string _categoryFilter = "All";

    // Key metrics
    private int _totalYouth = 0;
    private int _youthGrowth = 0;
    private int _totalPrograms = 0;
    private int _pendingPrograms = 0;
    private int _upcomingEvents = 0;
    private string _nextEventDate = "TBD";
    private int _unreadFeedback = 0;
    private int _totalFeedback = 0;

    // Chart data
    private Dictionary<string, int> _programsByCategory = new();
    private Dictionary<string, int> _youthByGender = new();
    private Dictionary<string, int> _youthByCivilStatus = new();
    private Dictionary<string, int> _youthByAgeGroup = new();
    private Dictionary<string, int> _registrationTrend = new();

    // Chart series for MudChart
    private List<ChartSeries> _programsChartSeries = new();
    private string[] _programsChartLabels = Array.Empty<string>();
    private List<ChartSeries> _civilStatusChartSeries = new();
    private string[] _civilStatusChartLabels = Array.Empty<string>();

    // Activity data
    private List<ActivityItem> _recentActivities = new();

    // Authorization
    private bool _isAuthorized = false;
    private bool _isLoading = true;
    private string _councilArea = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isLoading)
        {
            return;
        }

        if (firstRender)
        {
            await UserState.InitializeAsync();

            if (!UserState.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/login", forceLoad: true);
                return;
            }

            using var db = await DbFactory.CreateDbContextAsync();
            var currentUser = await db.Users.FirstOrDefaultAsync(u => u.Username == UserState.Username);

            if (currentUser == null || currentUser.Role != "Council")
            {
                _isAuthorized = false;
                _isLoading = false;
                StateHasChanged();
                return;
            }

            _councilArea = currentUser.Area ?? string.Empty;
            _isAuthorized = true;

            await LoadDashboardData();
        }
    }

    private async Task LoadDashboardData()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        // Apply filters - ALL queries filtered by council area
        var youthQuery = context.Youths.Where(y => y.Barangay == _councilArea);
        var programQuery = context.ProgramsProjects.Where(p => p.ProposerArea == _councilArea);
        var eventQuery = context.Events.Where(e => e.OrganizerArea == _councilArea);
        var announcementQuery = context.Announcements.Where(a => a.AuthorArea == _councilArea);

        // Feedback from youth in this barangay + forwarded feedback
        var youthEmails = await context.Youths
            .Where(y => y.Barangay == _councilArea)
            .Select(y => y.Email)
            .ToListAsync();
        var feedbackQuery = context.Feedbacks.Where(f =>
            youthEmails.Contains(f.Email) ||
            (f.IsForwarded && f.ForwardedToBarangays != null &&
             f.ForwardedToBarangays.Contains(_councilArea))
        );

        // Period filter
        var startDate = _periodFilter switch
        {
            "Today" => DateTime.Today,
            "Week" => DateTime.Today.AddDays(-7),
            "Month" => DateTime.Today.AddMonths(-1),
            "Year" => DateTime.Today.AddYears(-1),
            _ => DateTime.MinValue
        };

        if (_periodFilter != "All")
        {
            youthQuery = youthQuery.Where(y => y.DateRegistered >= startDate);
            programQuery = programQuery.Where(p => p.DateCreated >= startDate);
            eventQuery = eventQuery.Where(e => e.DateCreated >= startDate);
            announcementQuery = announcementQuery.Where(a => a.DateCreated >= startDate);
            feedbackQuery = feedbackQuery.Where(f => f.DateSubmitted >= startDate);
        }

        // Category filter
        if (_categoryFilter != "All")
        {
            programQuery = programQuery.Where(p => p.Category == _categoryFilter);
        }

        // Load key metrics
        _totalYouth = await youthQuery.CountAsync();

        var lastMonthYouth = await context.Youths
            .Where(y => y.Barangay == _councilArea && y.DateRegistered >= DateTime.Today.AddMonths(-1))
            .CountAsync();
        var previousMonthYouth = await context.Youths
            .Where(y => y.Barangay == _councilArea &&
                       y.DateRegistered >= DateTime.Today.AddMonths(-2) &&
                       y.DateRegistered < DateTime.Today.AddMonths(-1))
            .CountAsync();
        _youthGrowth = previousMonthYouth > 0 ? (int)((lastMonthYouth - previousMonthYouth) / (double)previousMonthYouth * 100) : 0;

        _totalPrograms = await programQuery.Where(p => p.Status == "Approved").CountAsync();
        _pendingPrograms = await programQuery.Where(p => p.Status == "Pending").CountAsync();

        _upcomingEvents = await eventQuery.Where(e => e.EventDate > DateTime.Now).CountAsync();
        var nextEvent = await eventQuery
            .Where(e => e.EventDate > DateTime.Now)
            .OrderBy(e => e.EventDate)
            .FirstOrDefaultAsync();
        _nextEventDate = nextEvent?.EventDate.ToString("MMM dd") ?? "TBD";

        // Get current username for read tracking
        var currentUsername = UserState.Username ?? "";
        var allFeedback = await feedbackQuery.AsNoTracking().ToListAsync();
        _unreadFeedback = allFeedback.Count(f => !f.IsReadByUser(currentUsername));
        _totalFeedback = allFeedback.Count;

        // Load chart data - Programs by Category
        _programsByCategory = await programQuery
            .Where(p => !string.IsNullOrEmpty(p.Category))
            .GroupBy(p => p.Category!)
            .Select(g => new { Category = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Category, x => x.Count);

        if (_programsByCategory.Any())
        {
            _programsChartLabels = _programsByCategory.Keys.ToArray();
            _programsChartSeries = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "Programs",
                    Data = _programsByCategory.Values.Select(v => (double)v).ToArray()
                }
            };
        }

        // Youth by Gender
        _youthByGender = await youthQuery
            .Where(y => !string.IsNullOrEmpty(y.Gender))
            .GroupBy(y => y.Gender!)
            .Select(g => new { Gender = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Gender, x => x.Count);

        // Youth by Civil Status
        _youthByCivilStatus = await youthQuery
            .Where(y => !string.IsNullOrEmpty(y.CivilStatus))
            .GroupBy(y => y.CivilStatus!)
            .Select(g => new { Status = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Status, x => x.Count);

        if (_youthByCivilStatus.Any())
        {
            _civilStatusChartLabels = _youthByCivilStatus.Keys.ToArray();
            _civilStatusChartSeries = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "Youth Count",
                    Data = _youthByCivilStatus.Values.Select(v => (double)v).ToArray()
                }
            };
        }

        // Registration trend (last 6 months)
        _registrationTrend = new Dictionary<string, int>();
        for (int i = 5; i >= 0; i--)
        {
            var monthStart = DateTime.Today.AddMonths(-i).Date.AddDays(1 - DateTime.Today.Day);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);
            var count = await context.Youths
                .Where(y => y.Barangay == _councilArea &&
                           y.DateRegistered >= monthStart &&
                           y.DateRegistered <= monthEnd)
                .CountAsync();
            _registrationTrend[monthStart.ToString("MMM")] = count;
        }

        // Youth by age group
        var today = DateTime.Today;
        var youthList = await youthQuery.AsNoTracking().ToListAsync();

        _youthByAgeGroup = new Dictionary<string, int>();
        if (youthList.Any())
        {
            var grouped = youthList.GroupBy(y =>
            {
                var age = today.Year - y.DateOfBirth.Year;
                if (y.DateOfBirth > today.AddYears(-age)) age--;

                return age switch
                {
                    <= 15 => "15 & Under",
                    <= 18 => "16-18",
                    <= 21 => "19-21",
                    <= 24 => "22-24",
                    _ => "25 & Above"
                };
            });

            foreach (var group in grouped)
            {
                _youthByAgeGroup[group.Key] = group.Count();
            }
        }

        // Load recent activities
        await LoadRecentActivities(context);

        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadRecentActivities(AppDbContext context)
    {
        _recentActivities = new List<ActivityItem>();

        // Recent youth registrations from this barangay
        var recentYouth = await context.Youths
            .Where(y => y.Barangay == _councilArea)
            .OrderByDescending(y => y.DateRegistered)
            .Take(2)
            .AsNoTracking()
            .ToListAsync();

        foreach (var youth in recentYouth)
        {
            _recentActivities.Add(new ActivityItem
            {
                Icon = Icons.Material.Filled.PersonAdd,
                Color = "#667eea",
                Title = "New Youth Registered",
                Description = $"{youth.FullName}",
                TimeAgo = GetTimeAgo(youth.DateRegistered)
            });
        }

        // Recent events from this council
        var recentEvents = await context.Events
            .Where(e => e.OrganizerArea == _councilArea)
            .OrderByDescending(e => e.DateCreated)
            .Take(2)
            .AsNoTracking()
            .ToListAsync();

        foreach (var evt in recentEvents)
        {
            _recentActivities.Add(new ActivityItem
            {
                Icon = Icons.Material.Filled.Event,
                Color = "#10b981",
                Title = "Event Created",
                Description = evt.Title,
                TimeAgo = GetTimeAgo(evt.DateCreated)
            });
        }

        // Recent announcements from this council
        var recentAnnouncements = await context.Announcements
            .Where(a => a.AuthorArea == _councilArea && a.IsPublished)
            .OrderByDescending(a => a.DateCreated)
            .Take(2)
            .AsNoTracking()
            .ToListAsync();

        foreach (var announcement in recentAnnouncements)
        {
            _recentActivities.Add(new ActivityItem
            {
                Icon = Icons.Material.Filled.Announcement,
                Color = "#ef4444",
                Title = "Announcement Posted",
                Description = announcement.Subject,
                TimeAgo = GetTimeAgo(announcement.DateCreated)
            });
        }

        // Recent programs from this council
        var recentPrograms = await context.ProgramsProjects
            .Where(p => p.ProposerArea == _councilArea)
            .OrderByDescending(p => p.DateCreated)
            .Take(2)
            .AsNoTracking()
            .ToListAsync();

        foreach (var program in recentPrograms)
        {
            _recentActivities.Add(new ActivityItem
            {
                Icon = Icons.Material.Filled.Work,
                Color = "#f59e0b",
                Title = "Program Proposed",
                Description = program.Title,
                TimeAgo = GetTimeAgo(program.DateCreated)
            });
        }

        // Sort by most recent and take top 10
        _recentActivities = _recentActivities
            .OrderByDescending(a => ParseTimeAgo(a.TimeAgo))
            .Take(10)
            .ToList();
    }

    private string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;

        if (timeSpan.TotalMinutes < 1) return "Just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays}d ago";

        return dateTime.ToString("MMM dd, yyyy");
    }

    private DateTime ParseTimeAgo(string timeAgo)
    {
        if (timeAgo == "Just now")
            return DateTime.Now;

        var parts = timeAgo.Split(' ');
        if (parts.Length < 2)
            return DateTime.Now.AddDays(-30);

        if (!int.TryParse(parts[0], out int value))
            return DateTime.Now.AddDays(-30);

        return parts[1] switch
        {
            "m" => DateTime.Now.AddMinutes(-value),
            "h" => DateTime.Now.AddHours(-value),
            "d" => DateTime.Now.AddDays(-value),
            _ => DateTime.Now.AddDays(-30)
        };
    }

    private bool HasActiveFilters()
    {
        return _periodFilter != "Month" || _categoryFilter != "All";
    }

    private async Task ClearFilters()
    {
        _periodFilter = "Month";
        _categoryFilter = "All";
        await LoadDashboardData();
    }

    private class ActivityItem
    {
        public string Icon { get; set; } = "";
        public string Color { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string TimeAgo { get; set; } = "";
    }
}